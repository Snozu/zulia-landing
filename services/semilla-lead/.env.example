# === Servicio de leads de Semilla ===
# Copia este archivo a `.env` (en el VPS) y llena los valores. NO lo subas al repo.

# Proveedor de correo transaccional (Resend). Consíguela en https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente. El dominio (zulia.lat) debe estar VERIFICADO en Resend (SPF/DKIM/DMARC).
LEAD_FROM=Semilla ZulIA <semilla@zulia.lat>

# (Opcional) Correo donde quieres que te avise cada vez que entra un lead.
LEAD_NOTIFY=haziel.zul@tendencys.com

# Token secreto para consultar el conteo:  GET /api/lead/count?token=EL_TOKEN
LEAD_COUNT_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# Origen permitido para CORS (el dominio del sitio).
ALLOWED_ORIGIN=https://zulia.lat
