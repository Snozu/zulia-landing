---
import type { Project } from '../lib/projects';
import { projectUrl } from '../lib/projects';
import { LINE_LABEL, STATUS_LABEL } from '../data/site';

interface Props {
  project: Project;
  size?: 'wide' | 'tall' | 'normal';
  loading?: 'eager' | 'lazy';
}
const { project, size = 'normal', loading = 'lazy' } = Astro.props;
const d = project.data;
---

<a class={`ptile ptile-${size}`} href={projectUrl(project)} data-line={d.line}>
  <div class="media">
    {d.cover ? (
      <img src={d.cover} alt={d.coverAlt ?? d.title} loading={loading} decoding="async" />
    ) : (
      <div class="placeholder">
        <span class="line">{LINE_LABEL[d.line]}</span>
        <strong>{d.title}</strong>
      </div>
    )}
    <span class="badge status">{STATUS_LABEL[d.status]}</span>
  </div>
  <div class="meta">
    <div class="row">
      <h3 class="h3">{d.title}</h3>
      <span class="client">{d.client}</span>
    </div>
    <p class="summary">{d.summary}</p>
    <p class="facts">{d.sector} · {d.city} · {d.year}</p>
  </div>
</a>

<style>
  .ptile {
    display: grid;
    grid-template-rows: auto 1fr;
    color: inherit;
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  .ptile:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .ptile:hover .h3 { color: var(--blue-dark); }
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(160deg, var(--paper-deep), var(--paper));
    border-bottom: 1px solid var(--line);
  }
  .ptile-wide .media { aspect-ratio: 21 / 10; }
  .media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 400ms ease; }
  .ptile:hover .media img { transform: scale(1.02); }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: .5rem;
    padding: 1.5rem;
    background: var(--glow), linear-gradient(160deg, #1b2230, #0e1013 70%);
    color: #f2f3f5;
  }
  .placeholder .line { padding: .25rem .6rem; border-radius: 999px; background: rgb(255 255 255 / .08); color: #a4b9dc; font-size: .72rem; font-weight: 600; }
  .placeholder strong { font-size: 1.5rem; font-weight: 620; letter-spacing: -.02em; }
  .status { position: absolute; top: .75rem; left: .75rem; box-shadow: var(--shadow-sm); }
  .meta { display: grid; gap: .5rem; align-content: start; padding: 1.1rem 1.25rem 1.3rem; }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .row .h3 { transition: color 140ms ease; }
  .client { flex: 0 0 auto; color: var(--text-muted); font-size: .82rem; font-weight: 500; }
  .summary { color: var(--text-muted); font-size: .92rem; line-height: 1.5; }
  .facts { color: var(--text-muted); font-size: .78rem; }
  @media (prefers-reduced-motion: reduce) { .ptile, .media img { transition: none; } .ptile:hover { transform: none; } }
</style>
