---
import type { Project } from '../lib/projects';
import { projectUrl } from '../lib/projects';
import { LINE_LABEL, STATUS_LABEL } from '../data/site';

interface Props {
  project: Project;
  size?: 'wide' | 'tall' | 'normal';
  loading?: 'eager' | 'lazy';
}
const { project, size = 'normal', loading = 'lazy' } = Astro.props;
const d = project.data;
---

<a class={`ptile ptile-${size}`} href={projectUrl(project)} data-line={d.line}>
  <div class="media stage">
    {d.cover ? (
      <img src={d.cover} alt={d.coverAlt ?? d.title} loading={loading} decoding="async" />
    ) : (
      <div class="placeholder">
        <span class="mono">{LINE_LABEL[d.line]}</span>
        <strong>{d.title}</strong>
        <span class="mono note">Captura en preparación</span>
      </div>
    )}
    <span class="badge status">{STATUS_LABEL[d.status]}</span>
  </div>
  <div class="meta">
    <h3 class="h3">{d.title}</h3>
    <p class="mono">{d.client} · {d.sector} · {d.year}</p>
    <p class="summary">{d.summary}</p>
  </div>
</a>

<style>
  .ptile {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }
  .ptile:hover .media img { transform: scale(1.015); }
  .ptile:hover .h3 { color: var(--blue-dark); }
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 0;
    border-radius: 0;
  }
  .ptile-wide .media { aspect-ratio: 21 / 10; }
  .ptile-tall .media { aspect-ratio: 4 / 3; }
  .media img { transition: transform 300ms ease; }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    gap: .35rem;
    padding: 1.25rem;
    color: var(--stage-text);
  }
  .placeholder strong { font-size: 1.4rem; font-weight: 600; letter-spacing: -.02em; }
  .placeholder .mono { color: var(--stage-muted); }
  .placeholder .note { color: var(--brand-blue); }
  .status {
    position: absolute;
    top: .75rem;
    left: .75rem;
    background: var(--paper);
    border-color: transparent;
  }
  .meta { display: grid; gap: .45rem; align-content: start; padding: 1.1rem 1.25rem 1.4rem; }
  .meta .h3 { transition: color 140ms ease; }
  .summary { color: var(--text-muted); font-size: .92rem; line-height: 1.5; }
  @media (prefers-reduced-motion: reduce) { .media img { transition: none; } }
</style>
