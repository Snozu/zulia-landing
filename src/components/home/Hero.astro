---
import { CTA } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell grid">
    <div class="copy">
      <h1 id="hero-title" class="display">Tus sistemas, operados desde un chat de IA.</h1>
      <p class="lead">Conectamos el ERP, el CRM, el correo y WhatsApp que tu empresa ya usa a una capa de inteligencia que consulta, ejecuta y pide aprobación cuando toca.</p>
      <div class="ctas">
        <a class="btn" href={CTA.primaryHref}>{CTA.primary}</a>
        <a class="link" href={CTA.secondaryHref}>
          {CTA.secondary}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
        </a>
      </div>
    </div>

    <div class="stack" aria-hidden="true">
      <figure class="stage panel panel-back">
        <img src="/projects/envia-copilot.webp" alt="" width="1600" height="882" loading="eager" decoding="async" />
      </figure>
      <figure class="stage panel panel-front">
        <img src="/projects/montia.webp" alt="" width="1600" height="1000" loading="eager" decoding="async" fetchpriority="high" />
        <figcaption class="caption">
          <span class="mono">MontIA · Grupo Mont · En producción</span>
        </figcaption>
      </figure>
      <div class="approval">
        <span class="mono">Aprobación requerida</span>
        <strong>¿Autorizar pedido 4512 por $1,800.00?</strong>
        <div class="approval-actions"><span>Cancelar</span><b>Aprobar</b></div>
      </div>
    </div>
  </div>
  <hr class="rule" />
</section>

<style>
  .hero { padding-top: clamp(3.5rem, 7vw, 6rem); }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .copy { display: grid; gap: 1.6rem; align-content: start; padding-bottom: 1rem; }
  .copy h1 { max-width: 20ch; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; padding-top: .5rem; }

  .stack { position: relative; min-height: 26rem; }
  .panel { margin: 0; position: absolute; }
  .panel-back {
    right: -8%;
    top: 0;
    width: 88%;
    aspect-ratio: 16 / 9;
    opacity: .85;
  }
  .panel-front {
    left: 0;
    bottom: 0;
    width: 86%;
    aspect-ratio: 16 / 10;
    box-shadow: 0 30px 60px rgb(9 10 12 / .25);
  }
  .caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: .6rem .8rem;
    background: linear-gradient(to top, rgb(9 10 12 / .85), transparent);
  }
  .caption .mono { color: var(--stage-muted); }
  .approval {
    position: absolute;
    right: -4%;
    bottom: 12%;
    display: grid;
    gap: .5rem;
    width: min(17rem, 70%);
    padding: 1rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 18px 40px rgb(9 10 12 / .18);
  }
  .approval strong { font-size: .95rem; font-weight: 600; line-height: 1.3; }
  .approval-actions { display: flex; gap: .5rem; margin-top: .25rem; font-size: .82rem; }
  .approval-actions span,
  .approval-actions b {
    flex: 1;
    padding: .5rem .6rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    text-align: center;
    font-weight: 600;
  }
  .approval-actions b { background: var(--accent-surface); border-color: var(--accent-surface); color: #fff; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; align-items: start; }
    .stack { min-height: 0; margin-top: .5rem; }
    .panel-back { display: none; }
    .panel-front { position: relative; width: 100%; box-shadow: none; }
    .approval { right: .75rem; bottom: 3rem; width: min(15rem, 70%); }
  }
</style>
