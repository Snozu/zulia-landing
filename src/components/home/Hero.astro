---
import { CTA } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell grid">
    <div class="copy">
      <h1 id="hero-title" class="display">Tus sistemas, operados desde un chat de IA.</h1>
      <p class="lead">Conectamos el ERP, el CRM, el correo y WhatsApp que tu empresa ya usa a una capa de inteligencia que consulta, ejecuta y pide aprobación cuando toca.</p>
      <div class="ctas">
        <a class="btn" href={CTA.primaryHref}>{CTA.primary}</a>
        <a class="link" href={CTA.secondaryHref}>
          {CTA.secondary}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
        </a>
      </div>
    </div>

    <div class="stack" aria-hidden="true">
      <figure class="frame frame-back">
        <div class="chrome"><i></i><i></i><i></i><span>envia.com</span></div>
        <div class="shot"><img src="/projects/envia-copilot.webp" alt="" width="1600" height="882" loading="eager" decoding="async" /></div>
      </figure>
      <figure class="frame frame-front">
        <div class="chrome dark"><i></i><i></i><i></i><span>MontIA · Grupo Mont</span></div>
        <div class="shot"><img src="/projects/montia.webp" alt="" width="1600" height="1000" loading="eager" decoding="async" fetchpriority="high" /></div>
      </figure>
      <div class="approval">
        <span class="tag">Aprobación requerida</span>
        <strong>¿Autorizar pedido 4512 por $1,800.00?</strong>
        <div class="approval-actions"><span>Cancelar</span><b>Aprobar</b></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6.5fr) minmax(0, 5.5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .copy { display: grid; gap: 1.6rem; align-content: start; }
  .copy h1 { max-width: 20ch; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; padding-top: .5rem; }

  .stack { position: relative; min-height: 30rem; }
  .frame {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }
  .frame .shot { position: relative; aspect-ratio: 16 / 9; background: var(--paper-deep); }
  .frame-front .shot { aspect-ratio: 16 / 10; background: #0e1013; }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .chrome {
    display: flex;
    align-items: center;
    gap: .4rem;
    height: 2rem;
    padding: 0 .75rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-deep);
    color: var(--text-muted);
    font-size: .7rem;
  }
  .chrome i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--line-dark); }
  .chrome span { margin-left: .5rem; }
  .chrome.dark { background: #15181d; border-color: rgb(255 255 255 / .1); color: #9da5b0; }
  .chrome.dark i { background: #3a4048; }
  .frame-back { right: 0; top: 0; width: 82%; opacity: .95; }
  .frame-front { left: 0; bottom: 0; width: 84%; }
  .approval {
    position: absolute;
    right: -2%;
    bottom: 10%;
    display: grid;
    gap: .55rem;
    width: min(17rem, 70%);
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-md);
  }
  .tag {
    justify-self: start;
    padding: .25rem .6rem;
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--blue-dark);
    font-size: .72rem;
    font-weight: 650;
  }
  .approval strong { font-size: .95rem; font-weight: 600; line-height: 1.3; }
  .approval-actions { display: flex; gap: .5rem; margin-top: .15rem; font-size: .82rem; }
  .approval-actions span,
  .approval-actions b {
    flex: 1;
    padding: .55rem .6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-align: center;
    font-weight: 600;
  }
  .approval-actions b { background: var(--brand-blue); border-color: var(--brand-blue); color: #fff; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; align-items: start; }
    .stack { min-height: 0; margin-top: .5rem; }
    .frame-back { display: none; }
    .frame-front { position: relative; width: 100%; }
    .approval { right: .75rem; bottom: 2.5rem; width: min(15rem, 70%); }
  }
</style>
