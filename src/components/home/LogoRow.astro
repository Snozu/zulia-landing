---
import { BRANDS } from '../../data/site';
---

<section class="logos" aria-label="Marcas para las que hemos construido">
  <div class="shell">
    <p class="mono">Marcas y organizaciones para las que hemos construido</p>
    <ul class="row">
      {BRANDS.map((b) => (
        <li class:list={[{ plate: b.onDark }]}>
          <img src={b.file} alt={b.name} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logos { padding-block: 3rem; }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: .75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* The plate stays light in both themes so every logo keeps its original
     colours; nothing here recolours, greys out or inverts a client's mark. */
  .row li {
    display: grid;
    place-items: center;
    min-height: 5.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  /* Only for assets supplied as a white-only logo, which need a dark plate. */
  .row li.plate { background: var(--stage); border-color: var(--stage-line); }
  /* Muted at rest, full colour on hover. No inversion, and the plate stays light
     in both themes, so switching to dark never recolours a client's mark. */
  .row img {
    max-height: 2rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: .7;
    transition: filter 200ms ease, opacity 200ms ease;
  }
  .row li:hover img,
  .row li:focus-within img { filter: none; opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .row img { transition: none; } }
</style>
