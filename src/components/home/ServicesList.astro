---
import { services } from '../../data/services';
import Robot from 'phosphor-astro/RobotDuotone.astro';
import Cube from 'phosphor-astro/CubeDuotone.astro';
import Storefront from 'phosphor-astro/StorefrontDuotone.astro';
import GitBranch from 'phosphor-astro/GitBranchDuotone.astro';
import Chalkboard from 'phosphor-astro/ChalkboardTeacherDuotone.astro';
import Megaphone from 'phosphor-astro/MegaphoneDuotone.astro';

const icons: Record<string, any> = {
  agentica: Robot,
  software: Cube,
  sitios: Storefront,
  marketing: Megaphone,
  ingenieria: GitBranch,
  cursos: Chalkboard,
};
const [first, ...rest] = services;
const FirstIcon = icons[first.line];
---

<section class="services section" id="servicios" aria-labelledby="services-title">
  <div class="shell">
    <p class="label">Servicios</p>
    <h2 id="services-title" class="h2">Seis formas de trabajar con nosotros.</h2>

    <div class="grid">
      <a class="card feature" href={`/servicios/${first.slug}/`}>
        <div class="feature-copy">
          <span class="icon"><FirstIcon width="28" height="28" aria-hidden="true" /></span>
          <h3 class="h3">{first.name}</h3>
          <p>{first.promise}</p>
          <span class="link">Ver servicio
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
          </span>
        </div>
        <figure class="feature-shot">
          <img src="/projects/envia-copilot.webp" alt="Envia Copilot ejecutando acciones dentro de la plataforma" loading="lazy" decoding="async" width="1600" height="882" />
        </figure>
      </a>
      {rest.map((s) => {
        const Icon = icons[s.line];
        return (
          <a class="card item" href={`/servicios/${s.slug}/`}>
            <span class="icon"><Icon width="26" height="26" aria-hidden="true" /></span>
            <h3 class="h3">{s.name}</h3>
            <p>{s.promise}</p>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services .h2 { margin-top: 1rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .card { color: inherit; text-decoration: none; transition: transform 220ms ease, box-shadow 220ms ease; }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .card:hover .h3 { color: var(--blue-dark); }
  .feature {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 2rem;
    overflow: hidden;
  }
  .feature-copy { display: grid; gap: 1rem; align-content: center; padding: 2.25rem; }
  .feature-copy p { color: var(--text-muted); font-size: 1.05rem; max-width: 40ch; }
  .feature-shot { position: relative; margin: 0; min-height: 18rem; background: var(--stage); overflow: hidden; }
  .feature-shot img {
    position: absolute;
    left: 8%;
    top: 12%;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm) 0 0 0;
    box-shadow: var(--shadow-lg);
  }
  .icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    background: var(--blue-soft);
    color: var(--blue-dark);
  }
  .item { display: grid; gap: .9rem; align-content: start; padding: 1.75rem; }
  .item p { color: var(--text-muted); font-size: .95rem; line-height: 1.5; }
  .item .h3 { transition: color 140ms ease; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .feature { grid-template-columns: 1fr; }
    .feature-shot { min-height: 14rem; }
  }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>
