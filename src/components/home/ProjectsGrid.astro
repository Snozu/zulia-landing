---
import ProjectTile from '../ProjectTile.astro';
import { getFeaturedProjects } from '../../lib/projects';
const projects = await getFeaturedProjects(6);
const sizes: Array<'wide' | 'normal' | 'tall'> = ['wide', 'normal', 'normal', 'normal', 'wide', 'normal'];
---

<section class="projects section" id="proyectos" aria-labelledby="projects-title">
  <div class="shell head">
    <div>
      <p class="label">Proyectos</p>
      <h2 id="projects-title" class="h2">Producto real, en producción, con nombre y apellido.</h2>
    </div>
    <a class="link" href="/proyectos/">
      Ver los 20 proyectos
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
    </a>
  </div>

  <div class="shell body">
    <aside class="rail" aria-hidden="true">
      <span class="mono">Logística · Industria · Fintech · Retail · Acero</span>
      <span class="mono">Monterrey · Lima · 2025 a 2026</span>
    </aside>
    <div class="hairline-grid bento">
      {projects.map((p, i) => <ProjectTile project={p} size={sizes[i] ?? 'normal'} loading={i < 2 ? 'eager' : 'lazy'} />)}
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .head .h2 { margin-top: 1rem; }
  .body {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 1.25rem;
  }
  .rail {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    border-right: 1px solid var(--line);
  }
  .rail .mono {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: .66rem;
  }
  .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .bento > :global(.ptile-wide) { grid-column: span 2; }
  @media (max-width: 900px) {
    .head { flex-direction: column; align-items: start; }
    .body { grid-template-columns: 1fr; }
    .rail { display: none; }
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; }
    .bento > :global(.ptile-wide) { grid-column: auto; }
  }
</style>
