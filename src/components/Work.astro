---
import Check from 'phosphor-astro/CheckBold.astro';
import LockSimple from 'phosphor-astro/LockSimpleBold.astro';
import PaperPlaneTilt from 'phosphor-astro/PaperPlaneTiltFill.astro';
import WhatsappLogo from 'phosphor-astro/WhatsappLogoFill.astro';
---

<section id="productos" class="section-pad products" aria-labelledby="products-title" data-product-theater>
  <div class="page-shell">
    <header class="products-head" data-reveal>
      <div>
        <p class="kicker">Producto real, no demos de humo</p>
        <h2 id="products-title" class="section-title">Mira lo que sabemos poner a trabajar.</h2>
      </div>
      <p>Haz clic en cada producto. Las escenas muestran cómo una interfaz sencilla puede coordinar sistemas, datos y acciones complejas por debajo.</p>
    </header>

    <div class="theater" data-reveal>
      <div class="product-tabs" role="tablist" aria-label="Productos construidos">
        <button id="tab-copilot" type="button" role="tab" aria-selected="true" aria-controls="panel-copilot" data-product-tab="copilot">
          <strong>Envia Copilot</strong><small>En producción</small><i></i>
        </button>
        <button id="tab-enzo" type="button" role="tab" aria-selected="false" aria-controls="panel-enzo" tabindex="-1" data-product-tab="enzo">
          <strong>Enzo</strong><small>En producción</small><i></i>
        </button>
        <button id="tab-montia" type="button" role="tab" aria-selected="false" aria-controls="panel-montia" tabindex="-1" data-product-tab="montia">
          <strong>MontIA</strong><small>Asistente ejecutivo</small><i></i>
        </button>
      </div>

      <div class="product-panels">
        <div id="panel-copilot" class="product-panel is-active" role="tabpanel" aria-labelledby="tab-copilot" data-product-panel="copilot">
          <div class="panel-copy">
            <p class="product-context">Envia.com · Portal operativo</p>
            <h3>Envia<br />Copilot</h3>
            <p>Convierte una conversación en trabajo real: cotiza, crea guías, rastrea paquetes, agenda recolecciones, abre tickets y consulta analítica sin recorrer decenas de pantallas.</p>
            <ul><li><Check width="13" height="13" /> 15+ agentes especializados</li><li><Check width="13" height="13" /> 50+ herramientas operativas</li><li><Check width="13" height="13" /> Texto, voz e imagen</li></ul>
            <a href="https://blog.envia.com/en/inteligencia-artificial-logistica-ecommerce/" target="_blank" rel="noreferrer">Ver contexto público</a>
          </div>
          <div class="stage stage-copilot" aria-label="Captura real de Envia Copilot">
            <div class="app-window">
              <div class="window-bar"><span><i></i><i></i><i></i></span><small>shipping.envia.com</small><em>En línea</em></div>
              <img src="/products/envia-copilot-portal.webp" alt="Portal de Envia.com con Envia Copilot abierto" width="1600" height="882" loading="lazy" decoding="async" />
              <div class="task-bubble"><small>Copilot está trabajando</small><strong>Consultando información del envío…</strong><i></i></div>
            </div>
          </div>
        </div>

        <div id="panel-enzo" class="product-panel" role="tabpanel" aria-labelledby="tab-enzo" data-product-panel="enzo" hidden>
          <div class="panel-copy">
            <p class="product-context">Envia.com · WhatsApp</p>
            <h3>Enzo</h3>
            <p>Un asistente logístico dentro del canal que el cliente ya usa. Responde, verifica identidad y ejecuta acciones con el contexto de la conversación.</p>
            <ul><li><Check width="13" height="13" /> Crear y cancelar envíos</li><li><Check width="13" height="13" /> Cotizar y rastrear</li><li><Check width="13" height="13" /> Escalar a una persona</li></ul>
            <a href="https://help.envia.com/it/chi-e-enzo/" target="_blank" rel="noreferrer">Ver capacidades oficiales</a>
          </div>
          <div class="stage stage-enzo">
            <div class="phone">
              <div class="phone-head"><span class="enzo-avatar">E</span><div><strong>Enzo</strong><small>en línea</small></div><WhatsappLogo width="20" height="20" /></div>
              <div class="chat-body">
                <p class="chat-day">Hoy</p>
                <div class="message received one">¡Hola! Soy Enzo 👋 ¿Qué necesitas hacer con tu envío?<small>10:41</small></div>
                <div class="message sent two">Cotiza un paquete de Monterrey a CDMX, pesa 2 kg.<small>10:42 ✓✓</small></div>
                <div class="typing three"><i></i><i></i><i></i></div>
                <div class="quote-card four"><span>Cotización lista</span><strong>$189.40 MXN</strong><p>Entrega estimada: 1–2 días</p><b>Crear envío</b></div>
                <div class="message sent five">Crear envío<small>10:42 ✓✓</small></div>
                <div class="success-action six"><Check width="16" height="16" /><span><strong>Envío creado</strong><small>Guía #ENV-38492</small></span></div>
              </div>
              <div class="chat-input"><span>Escribe un mensaje</span><i><PaperPlaneTilt width="14" height="14" /></i></div>
            </div>
            <div class="channel-note"><span>Canal familiar</span><strong>Acciones reales detrás del chat</strong></div>
          </div>
        </div>

        <div id="panel-montia" class="product-panel" role="tabpanel" aria-labelledby="tab-montia" data-product-panel="montia" hidden>
          <div class="panel-copy">
            <p class="product-context">Producto privado · Asistente ejecutivo</p>
            <h3>MontIA</h3>
            <p>Una capa personal para dirección que conecta WhatsApp, correo, archivos y operación. Conserva memoria, aprende reglas y detecta compromisos o riesgos antes de que se conviertan en otra junta.</p>
            <ul><li><Check width="13" height="13" /> Memoria ejecutiva con evidencia</li><li><Check width="13" height="13" /> Señales y briefs proactivos</li><li><Check width="13" height="13" /> Acciones bajo permisos y aprobación</li></ul>
            <span class="private-link"><LockSimple width="14" height="14" /> Instalación aislada para cada dirección</span>
          </div>
          <div class="stage stage-montia">
            <div class="montia-screen">
              <img src="/products/montia-actuo-antes.webp" width="1600" height="900" loading="lazy" decoding="async" alt="Interfaz pública anonimizada de MontIA detectando un compromiso antes de que dirección pregunte" />
              <span class="montia-scan scan-signal" aria-hidden="true"></span>
              <span class="montia-scan scan-action" aria-hidden="true"></span>
              <span class="montia-scan scan-decision" aria-hidden="true"></span>
            </div>
            <p class="montia-caption"><span>Ejemplo anonimizado</span> Detectó · contrastó · actuó · escaló sólo la decisión.</p>
          </div>
        </div>

      </div>
    </div>

    <p class="ownership-note">Los productos de Envia.com se muestran como experiencia profesional de Haziel dentro de su equipo. Las marcas pertenecen a sus respectivos propietarios.</p>
  </div>
</section>

<style>
  .products { overflow: hidden; background: var(--night); color: var(--night-text); }
  .products .kicker { color: var(--night-accent); }
  .products-head { display: grid; grid-template-columns: 1.2fr .55fr; align-items: end; gap: clamp(3rem, 8vw, 8rem); margin-bottom: clamp(3rem, 6vw, 5rem); }
  .products-head > p { max-width: 29rem; margin: 0; color: var(--night-muted); font-size: .9rem; line-height: 1.7; }
  .theater { overflow: visible; }
  .product-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: .3rem; padding: .4rem; border: 0; border-radius: 2rem; background: var(--night-glass); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .product-tabs button { position: relative; display: grid; min-height: 4.8rem; grid-template-rows: 1fr 1fr; align-items: end; gap: 0; padding: .8rem 1rem; overflow: hidden; border: 0; border-radius: 1.55rem; background: transparent; color: var(--night-subtle); cursor: pointer; font: inherit; text-align: left; transition: color 180ms ease, background 180ms ease; }
  .product-tabs button:hover { color: var(--night-text); }
  .product-tabs button[aria-selected="true"] { background: var(--night-glass-strong); color: var(--night-text); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--night-text) 10%, transparent); }
  .product-tabs strong { align-self: end; font-size: .82rem; letter-spacing: -.02em; }
  .product-tabs small { align-self: start; font-size: .5rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }
  .product-tabs button > i { position: absolute; right: 1rem; bottom: .8rem; width: .38rem; height: .38rem; border-radius: 50%; background: var(--night-accent); opacity: 0; }
  .product-tabs button[aria-selected="true"] > i { opacity: 1; animation: tab-pulse 2.4s ease-in-out infinite; }
  .theater.is-paused .product-tabs button[aria-selected="true"] > i { animation-play-state: paused; }
  .product-panel { display: none; grid-template-columns: minmax(17rem, .56fr) minmax(0, 1.44fr); min-height: 41rem; margin-top: 1rem; overflow: hidden; border-radius: 3rem 3rem 7rem 3rem; background: var(--night-panel); box-shadow: var(--glass-shadow); }
  .product-panel.is-active { display: grid; animation: panel-in 420ms cubic-bezier(.2,.8,.2,1); }
  .panel-copy { display: flex; min-width: 0; flex-direction: column; padding: clamp(2.5rem, 4vw, 4.5rem); }
  .product-context { margin: 0; color: var(--night-subtle); font-size: .55rem; font-weight: 700; letter-spacing: .065em; text-transform: uppercase; }
  .panel-copy h3 { margin: 2rem 0 0; font-size: clamp(3.5rem, 6vw, 6.3rem); font-weight: 690; letter-spacing: -.085em; line-height: .83; }
  .panel-copy > p:not(.product-context) { margin: 1.7rem 0 0; color: var(--night-muted); font-size: .82rem; line-height: 1.7; }
  .panel-copy ul { display: grid; gap: .65rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .panel-copy li { display: flex; align-items: center; gap: .55rem; color: var(--night-text); font-size: .66rem; font-weight: 600; }
  .panel-copy li svg { color: var(--night-accent); }
  .panel-copy > a, .private-link { display: flex; width: fit-content; align-items: center; gap: .55rem; margin-top: auto; padding: .75rem 1rem; border: 0; border-radius: 1.4rem; background: var(--night-glass); color: var(--night-text); font-size: .68rem; font-weight: 700; text-decoration: none; box-shadow: inset 0 1px 0 color-mix(in srgb, var(--night-text) 10%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  .panel-copy > a:hover { color: var(--night-accent); }
  .stage { position: relative; display: grid; min-width: 0; place-items: center; overflow: hidden; padding: clamp(1.5rem, 4vw, 4rem); background: var(--night-panel-soft); }
  .stage-copilot { background: radial-gradient(circle at 82% 18%, rgb(109 142 204 / .16), transparent 34%), linear-gradient(145deg, #e9edf1, #cfd6dc); }

  .app-window { position: relative; width: min(100%, 52rem); overflow: hidden; border: 1px solid #44444b; border-radius: .85rem; background: white; box-shadow: 0 25px 80px rgb(0 0 0 / .28); }
  .window-bar { display: grid; min-height: 2.65rem; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 .8rem; border-bottom: 1px solid #ddd; background: #f5f5f5; color: #666; font-size: .48rem; font-style: normal; }
  .window-bar > span { display: flex; gap: .3rem; }
  .window-bar span i { width: .5rem; height: .5rem; border-radius: 50%; background: #c7c7c7; }
  .window-bar span i:first-child { background: #ff6258; }
  .window-bar small { padding: .35rem 1rem; border: 1px solid #ddd; border-radius: .35rem; background: white; }
  .window-bar em { justify-self: end; color: var(--green); font-size: .48rem; font-style: normal; font-weight: 700; }
  .app-window img { display: block; width: 100%; height: auto; object-fit: contain; }
  .task-bubble { position: absolute; right: 1rem; bottom: 1rem; display: grid; min-width: 14rem; gap: .15rem; padding: .8rem .9rem; border: 1px solid #d6d6dd; border-radius: .65rem; background: rgb(255 255 255 / .96); box-shadow: 0 12px 32px rgb(9 9 11 / .16); color: #191b1f; animation: task-float 4.6s ease-in-out infinite; }
  .task-bubble small { color: var(--blue); font-size: .47rem; font-weight: 720; text-transform: uppercase; }
  .task-bubble strong { font-size: .59rem; }
  .task-bubble i { position: absolute; right: .8rem; top: .85rem; width: .42rem; height: .42rem; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 0 rgb(47 107 255 / .45); animation: ping 1.5s infinite; }

  .stage-enzo { grid-template-columns: 1fr auto; gap: 2rem; background: #dbe8df; }
  .stage-enzo::before { position: absolute; inset: 0; opacity: .3; background-image: radial-gradient(#6f927b 1px, transparent 1px); background-size: 18px 18px; content: ""; }
  .phone { position: relative; z-index: 1; width: min(100%, 25rem); overflow: hidden; border: 8px solid #202124; border-radius: 2rem; background: #efeae2; box-shadow: 0 30px 70px rgb(19 65 40 / .25); }
  .phone-head { display: grid; min-height: 4rem; grid-template-columns: auto 1fr auto; align-items: center; gap: .65rem; padding: .7rem .9rem; background: #075e54; color: white; }
  .enzo-avatar { display: grid; width: 2.45rem; height: 2.45rem; place-items: center; border-radius: 50%; background: white; color: #075e54; font-weight: 780; }
  .phone-head strong, .phone-head small { display: block; }
  .phone-head strong { font-size: .78rem; }
  .phone-head small { color: #cce6df; font-size: .5rem; }
  .chat-body { position: relative; min-height: 30rem; padding: .75rem; }
  .chat-day { width: max-content; margin: 0 auto .75rem; padding: .25rem .5rem; border-radius: .3rem; background: #fff; color: #667; font-size: .48rem; }
  .message { max-width: 78%; margin-bottom: .55rem; padding: .58rem .62rem .3rem; border-radius: .55rem; color: #222; font-size: .6rem; line-height: 1.45; opacity: 0; }
  .message small { display: block; margin-top: .2rem; color: #747474; font-size: .43rem; text-align: right; }
  .received { border-top-left-radius: .1rem; background: white; }
  .sent { margin-left: auto; border-top-right-radius: .1rem; background: #d9fdd3; }
  .typing { display: flex; width: max-content; gap: .2rem; margin-bottom: .55rem; padding: .65rem; border-radius: .55rem; background: white; opacity: 0; }
  .typing i { width: .35rem; height: .35rem; border-radius: 50%; background: #8b8b8b; animation: dot 1s infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
  .quote-card { width: 82%; margin-bottom: .55rem; padding: .75rem; border-radius: .6rem; background: white; color: #222; opacity: 0; }
  .quote-card span { color: #68716e; font-size: .48rem; text-transform: uppercase; }
  .quote-card strong { display: block; margin-top: .2rem; font-size: 1rem; }
  .quote-card p { margin: .15rem 0 .55rem; color: #667; font-size: .49rem; }
  .quote-card b { display: block; width: 100%; padding: .45rem; border-radius: .35rem; background: #128c7e; color: white; font-size: .52rem; font-weight: 700; text-align: center; }
  .success-action { display: flex; align-items: center; gap: .5rem; width: 82%; margin-top: .5rem; padding: .7rem; border: 1px solid #a9ddc0; border-radius: .55rem; background: #f4fff7; color: #138b4e; opacity: 0; }
  .success-action span, .success-action strong, .success-action small { display: block; }
  .success-action strong { color: #17492f; font-size: .56rem; }
  .success-action small { margin-top: .12rem; font-size: .46rem; }
  .product-panel.is-active .one { animation: chat-in 8s .2s infinite; }
  .product-panel.is-active .two { animation: chat-in 8s 1.1s infinite; }
  .product-panel.is-active .three { animation: chat-in 8s 2s infinite; }
  .product-panel.is-active .four { animation: chat-in 8s 3s infinite; }
  .product-panel.is-active .five { animation: chat-in 8s 4.3s infinite; }
  .product-panel.is-active .six { animation: chat-in 8s 5.2s infinite; }
  .chat-input { display: flex; align-items: center; justify-content: space-between; margin: 0 .7rem .7rem; padding: .65rem .7rem; border-radius: 1rem; background: white; color: #909090; font-size: .52rem; }
  .chat-input i { display: grid; width: 1.65rem; height: 1.65rem; place-items: center; border-radius: 50%; background: #128c7e; color: white; }
  .channel-note { position: relative; z-index: 1; width: 11rem; color: #17492f; }
  .channel-note span, .channel-note strong { display: block; }
  .channel-note span { margin-bottom: .55rem; font-size: .52rem; font-weight: 760; letter-spacing: .06em; text-transform: uppercase; }
  .channel-note strong { font-size: 1.3rem; letter-spacing: -.04em; line-height: 1.05; }

  .stage-montia { align-content: center; gap: 1rem; background: #0b0b0d; }
  .montia-screen { position: relative; width: min(100%, 58rem); overflow: hidden; border: 1px solid #34343a; border-radius: .65rem; box-shadow: 0 24px 70px rgb(0 0 0 / .38); }
  .montia-screen img { display: block; width: 100%; height: auto; }
  .montia-scan { position: absolute; border: 1px solid #6b8fff; border-radius: .32rem; opacity: 0; box-shadow: 0 0 0 4px rgb(79 112 255 / .08); pointer-events: none; }
  .scan-signal { top: 25%; right: 8%; width: 63%; height: 15%; animation: montia-focus 8s .2s infinite; }
  .scan-action { top: 45%; right: 8%; width: 63%; height: 22%; animation: montia-focus 8s 2.7s infinite; }
  .scan-decision { right: 8%; bottom: 14%; width: 63%; height: 14%; animation: montia-focus 8s 5.2s infinite; }
  .montia-caption { display: flex; justify-self: end; gap: .65rem; margin: 0; color: #787880; font-size: .49rem; line-height: 1.45; text-align: right; }
  .montia-caption span { color: #9bb4ff; font-weight: 720; letter-spacing: .04em; text-transform: uppercase; }

  .ownership-note { margin: 1rem 0 0; color: var(--night-subtle); font-size: .49rem; line-height: 1.45; }

  @keyframes tab-pulse { 50% { transform: scale(1.45); box-shadow: 0 0 0 5px rgb(141 171 255 / 0); } }
  @keyframes panel-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes task-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes ping { 70%, 100% { box-shadow: 0 0 0 7px rgb(47 107 255 / 0); } }
  @keyframes dot { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-3px); } }
  @keyframes chat-in { 0%, 8% { opacity: 0; transform: translateY(8px); } 14%, 92% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes montia-focus { 0%, 8%, 32%, 100% { opacity: 0; transform: translateY(5px); } 13%, 27% { opacity: 1; transform: none; } }

  @media (max-width: 980px) {
    .products-head { grid-template-columns: 1fr; align-items: start; }
    .product-panel { grid-template-columns: 1fr; }
    .panel-copy { min-height: 33rem; padding: clamp(2rem, 6vw, 4rem); }
    .stage { min-height: 37rem; }
  }

  @media (max-width: 700px) {
    .product-tabs { display: flex; overflow-x: auto; border-radius: 1.5rem; scroll-padding-inline: .4rem; scroll-snap-type: x mandatory; }
    .product-tabs button { min-width: 12.5rem; scroll-snap-align: start; }
    .product-panel { border-radius: 2rem 2rem 4rem 2rem; }
    .panel-copy { min-height: 28rem; padding: 2rem 1.5rem; }
    .stage { min-height: 31rem; padding: 1rem; }
    .stage-enzo { grid-template-columns: 1fr; }
    .channel-note { display: none; }
    .phone { width: min(100%, 22rem); }
    .app-window { width: 100%; }
    .task-bubble { right: .6rem; bottom: .6rem; min-width: 11rem; max-width: calc(100% - 1.2rem); }
  }
</style>

<script>
  const theaters = document.querySelectorAll<HTMLElement>('[data-product-theater]');

  theaters.forEach((theater) => {
    const frame = theater.querySelector<HTMLElement>('.theater');
    const tabs = Array.from(theater.querySelectorAll<HTMLButtonElement>('[data-product-tab]'));
    const panels = Array.from(theater.querySelectorAll<HTMLElement>('[data-product-panel]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let interval: number | undefined;

    const activate = (index: number, moveFocus = false) => {
      activeIndex = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === activeIndex;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === activeIndex;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
    };

    const stop = () => {
      if (interval) window.clearInterval(interval);
      interval = undefined;
      frame?.classList.add('is-paused');
    };

    const start = () => {
      if (reduceMotion) return;
      stop();
      frame?.classList.remove('is-paused');
      interval = window.setInterval(() => activate(activeIndex + 1), 7000);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => { activate(index); start(); });
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') { event.preventDefault(); activate(activeIndex + 1, true); start(); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); activate(activeIndex - 1, true); start(); }
        if (event.key === 'Home') { event.preventDefault(); activate(0, true); start(); }
        if (event.key === 'End') { event.preventDefault(); activate(tabs.length - 1, true); start(); }
      });
    });

    frame?.addEventListener('mouseenter', stop);
    frame?.addEventListener('mouseleave', start);
    frame?.addEventListener('focusin', stop);
    frame?.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !frame.contains(event.relatedTarget)) start();
    });
    start();
  });
</script>
