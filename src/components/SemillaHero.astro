---
---

<section class="seed-hero" aria-labelledby="seed-title" data-hero-tilt>
  <div class="hero-aurora" aria-hidden="true"></div>
  <div class="page-shell hero-layout">
    <div class="hero-copy">
      <span class="hero-chip"><i aria-hidden="true"></i> Acceso anticipado · en desarrollo</span>
      <h1 id="seed-title">Tu pipeline B2B, <em>lleno en automático.</em></h1>
      <p class="hero-lead">Semilla encuentra cuentas con encaje, escribe desde el contexto y da seguimiento hasta que hay una conversación real. Tu equipo solo entra a cerrar.</p>
      <div class="hero-actions">
        <a class="hero-primary" href="#acceso">Solicitar acceso <span aria-hidden="true">→</span></a>
        <a class="hero-secondary" href="#plataforma">Ver cómo funciona</a>
      </div>
      <p class="hero-note">Sin tarjeta · te avisamos cuando abramos tu lugar.</p>
    </div>

    <div class="hero-stage">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-run-float">
        <div class="hero-run" data-seed-run aria-label="Corrida de ejemplo del pipeline de Semilla">
          <header>
            <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <strong>semilla · pipeline</strong>
            <em data-run-phase>cazador</em>
          </header>

          <ol class="run-log">
            <li class="run-item" data-run-step="0">
              <span class="run-agent">cazador</span>
              <div class="run-body">
                <p class="run-meta">fuente: directorio · construcción · Monterrey · cargo: operaciones</p>
                <p class="run-account"><strong>142</strong> empresas con encaje ICP</p>
              </div>
            </li>
            <li class="run-item" data-run-step="1">
              <span class="run-agent">enriquecedor</span>
              <div class="run-body">
                <p>correo validado · riesgo de bounce <b class="ok">bajo</b> · SPF/DKIM verificado</p>
              </div>
            </li>
            <li class="run-item" data-run-step="2">
              <span class="run-agent">calificador</span>
              <div class="run-body">
                <p>score <strong>87/100</strong> vs ICP · decisor: Dir. de Operaciones</p>
              </div>
            </li>
            <li class="run-item" data-run-step="3">
              <span class="run-agent">redactor</span>
              <div class="run-body run-email">
                <p data-type-line>Vi que abrieron operación en tres estados este trimestre.</p>
                <p data-type-line>Llenamos pipeline B2B en frío sin cargarle trabajo manual a tu equipo.</p>
                <p data-type-line>¿Tiene sentido una llamada de 15 min?</p>
                <b>correo enviado · guardrail 18/40 del día · warmup activo</b>
              </div>
            </li>
            <li class="run-item" data-run-step="4">
              <span class="run-agent">conversador</span>
              <div class="run-body run-reply">
                <blockquote>“Sí, justo lo estamos viendo. ¿Me pasas horarios?”</blockquote>
                <p class="run-intent">intención clasificada: <b class="ok">interesado</b> · en segundos</p>
              </div>
            </li>
            <li class="run-item run-handoff" data-run-step="5">
              <span class="run-agent">handoff</span>
              <div class="run-body">
                <p><strong>Lead caliente → a tu equipo</strong></p>
                <p>Empresa, decisor, señal y conversación completa. El humano solo entra a cerrar.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
      <div class="hero-stat" aria-hidden="true">
        <strong><span data-count-to="87">0</span><small>/100</small></strong>
        <span>encaje del mejor lead</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-seed-run]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-run-step]')];
    const phase = root.querySelector<HTMLElement>('[data-run-phase]');
    const phases = ['cazador', 'enriquecedor', 'calificador', 'redactor', 'conversador', 'handoff'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      steps.forEach((step) => step.classList.add('is-on'));
      if (phase) phase.textContent = phases[phases.length - 1];
      return;
    }

    const typeLines = (item: HTMLElement) => {
      const lines = [...item.querySelectorAll<HTMLElement>('[data-type-line]')];
      lines.forEach((line, i) => {
        const full = line.textContent ?? '';
        line.textContent = '';
        line.classList.add('is-typing');
        setTimeout(() => {
          let pos = 0;
          const tick = window.setInterval(() => {
            pos += 2;
            line.textContent = full.slice(0, pos);
            if (pos >= full.length) {
              window.clearInterval(tick);
              line.classList.remove('is-typing');
            }
          }, 18);
        }, i * 900);
      });
    };

    // Se llena rápido (~2.5s) y se queda; el correo del Redactor se teclea como detalle.
    steps.forEach((step, i) => {
      setTimeout(() => {
        step.classList.add('is-on');
        if (phase) phase.textContent = phases[i] ?? '';
        if (i === 3) typeLines(step);
      }, 250 + i * 380);
    });
  });

  // Tilt 3D del panel siguiendo el cursor (solo puntero fino, respeta reduced-motion)
  const tiltHero = document.querySelector<HTMLElement>('[data-hero-tilt]');
  const tiltPanel = tiltHero?.querySelector<HTMLElement>('.hero-run');
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (tiltHero && tiltPanel && finePointer && !noMotion) {
    let frame = 0;
    tiltHero.addEventListener('pointermove', (event) => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        const rect = tiltHero.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        tiltPanel.style.setProperty('--tilt-x', (px * 5).toFixed(2) + 'deg');
        tiltPanel.style.setProperty('--tilt-y', (-py * 5).toFixed(2) + 'deg');
      });
    });
    tiltHero.addEventListener('pointerleave', () => {
      tiltPanel.style.setProperty('--tilt-x', '0deg');
      tiltPanel.style.setProperty('--tilt-y', '0deg');
    });
  }

  // Número que sube (count-up) al entrar en pantalla
  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
  if (counters.length && !noMotion && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        io.unobserve(el);
        const target = Number(el.dataset.countTo);
        const start = performance.now();
        const dur = 1400;
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round((1 - Math.pow(1 - p, 3)) * target));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    counters.forEach((c) => io.observe(c));
  } else {
    counters.forEach((c) => { c.textContent = c.dataset.countTo ?? ''; });
  }
</script>

<style>
  .seed-hero {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    background-image:
      radial-gradient(120% 62% at 88% -8%, color-mix(in srgb, var(--blue-dark) 16%, transparent), transparent 60%),
      radial-gradient(90% 52% at -5% 8%, color-mix(in srgb, var(--blue) 12%, transparent), transparent 55%);
  }

  .hero-aurora {
    position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
  }
  .hero-aurora::before, .hero-aurora::after { content: ""; position: absolute; border-radius: 50%; filter: blur(80px); opacity: .5; will-change: transform; }
  .hero-aurora::before { width: 40rem; height: 40rem; top: -16rem; right: -8rem; background: radial-gradient(circle, color-mix(in srgb, var(--blue-dark) 34%, transparent), transparent 62%); animation: aurora-a 19s ease-in-out infinite alternate; }
  .hero-aurora::after { width: 30rem; height: 30rem; top: 18%; left: -12rem; background: radial-gradient(circle, color-mix(in srgb, var(--blue) 24%, transparent), transparent 62%); animation: aurora-b 24s ease-in-out infinite alternate; }
  @keyframes aurora-a { to { transform: translate(-4rem, 3rem) scale(1.16); } }
  @keyframes aurora-b { to { transform: translate(5rem, -3rem) scale(1.12); } }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .96fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(4.5rem, 8vw, 7rem);
    min-height: min(calc(100dvh - 5rem), 54rem);
    perspective: 1300px;
  }

  /* Chip eyebrow */
  .hero-chip { display: inline-flex; align-items: center; gap: .55rem; padding: .42rem .9rem; border-radius: 999px; background: color-mix(in srgb, var(--blue-soft) 70%, var(--white)); border: 1px solid color-mix(in srgb, var(--blue-dark) 22%, transparent); color: var(--blue-dark); font-size: .76rem; font-weight: 640; }
  .hero-chip i { width: .5rem; height: .5rem; border-radius: 50%; background: var(--blue-dark); box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue-dark) 20%, transparent); }

  h1 {
    max-width: 15ch;
    margin: 1.3rem 0 0;
    font-size: clamp(2.7rem, 5.2vw, 4.4rem);
    font-weight: 720;
    letter-spacing: -.045em;
    line-height: 1.0;
    text-wrap: balance;
  }
  h1 em {
    font-style: normal;
    background: linear-gradient(100deg, #2f6bff, #5b8cff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 32rem;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .9rem; margin-top: 2.1rem; }

  .hero-primary {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .98rem 1.55rem; border-radius: 999px;
    background: linear-gradient(100deg, #2f6bff, #5b8cff);
    color: #fff; font-size: .92rem; font-weight: 680; text-decoration: none;
    box-shadow: 0 12px 26px -10px color-mix(in srgb, #2f6bff 65%, transparent);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .hero-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 34px -10px color-mix(in srgb, #2f6bff 72%, transparent); }
  .hero-primary:active { transform: translateY(0) scale(.99); }
  .hero-primary span { transition: transform 200ms ease; }
  .hero-primary:hover span { transform: translateX(3px); }

  .hero-secondary {
    display: inline-flex; align-items: center;
    padding: .98rem 1.35rem; border-radius: 999px;
    background: var(--white); border: 1px solid var(--line);
    color: var(--ink); font-size: .92rem; font-weight: 640; text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .hero-secondary:hover { border-color: var(--blue-dark); transform: translateY(-2px); }

  .hero-note { margin: 1.4rem 0 0; color: var(--text-muted); font-size: .82rem; }

  /* Product card — glossy, flotando */
  .hero-stage { position: relative; }
  .hero-glow { display: none; }
  .hero-run-float { position: relative; z-index: 1; animation: card-float 7.5s ease-in-out infinite; }
  @keyframes card-float { 50% { transform: translateY(-10px); } }

  .hero-run {
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--white);
    box-shadow: 0 34px 64px -30px rgb(8 12 28 / .5), 0 10px 24px -16px rgb(8 12 28 / .32);
    overflow: hidden;
    transform: rotateX(var(--tilt-y, 0deg)) rotateY(var(--tilt-x, 0deg));
    transform-style: preserve-3d;
    transition: transform 260ms cubic-bezier(.2,.8,.2,1);
    will-change: transform;
  }

  .hero-run > header {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding: .9rem 1.3rem;
    border-bottom: 1px solid var(--line);
    font-size: .72rem;
  }
  .win-dots { display: flex; gap: .4rem; }
  .win-dots i { width: .6rem; height: .6rem; border-radius: 50%; background: color-mix(in srgb, var(--line-dark) 50%, transparent); }
  .win-dots i:nth-child(3) { background: color-mix(in srgb, var(--blue-dark) 55%, transparent); }
  .hero-run > header strong { font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: -.01em; }
  .hero-run > header em { margin-left: auto; color: var(--text-muted); font-family: var(--font-mono); font-size: .66rem; font-style: normal; }

  .run-log { display: grid; gap: 0; margin: 0; padding: .5rem 0; list-style: none; }
  .run-item {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    gap: 1rem;
    padding: .85rem 1.3rem;
    opacity: 0;
    transform: translateY(.5rem);
    transition: opacity 460ms ease, transform 560ms cubic-bezier(.2,.8,.2,1);
  }
  .run-item.is-on { opacity: 1; transform: none; }
  .run-item + .run-item { border-top: 1px dashed color-mix(in srgb, var(--line) 72%, transparent); }

  .run-agent {
    padding-top: .1rem;
    color: var(--blue-dark);
    font-family: var(--font-mono);
    font-size: .62rem;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .run-body p { margin: 0 0 .3rem; font-size: .86rem; line-height: 1.55; }
  .run-body b { display: block; margin-top: .35rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .6rem; font-weight: 500; }
  .run-account strong { font-weight: 700; }
  .run-account { color: var(--ink); }
  .run-meta { color: var(--text-muted); font-family: var(--font-mono); font-size: .66rem; letter-spacing: -.01em; }
  .run-body b.ok { display: inline; margin: 0; color: var(--blue-dark); font-family: var(--font-mono); font-weight: 600; }
  .run-intent { margin-top: .45rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .68rem; }

  .run-email p { color: var(--ink-soft); }
  .run-email p.is-typing::after { content: '▍'; color: var(--blue-dark); animation: run-caret 1s steps(2) infinite; }
  @keyframes run-caret { 50% { opacity: 0; } }

  .run-reply blockquote { margin: 0; font-size: 1.02rem; font-weight: 620; letter-spacing: -.03em; line-height: 1.4; }

  .run-handoff { border-left: 3px solid var(--blue-dark); background: color-mix(in srgb, var(--blue-dark) 5%, transparent); }
  .run-handoff .run-agent { color: var(--blue-dark); }
  .run-handoff p:last-child { color: var(--text-muted); font-size: .78rem; }

  /* Stat chip flotante */
  .hero-stat {
    position: absolute; z-index: 2; left: -.7rem; bottom: 1.6rem;
    display: flex; flex-direction: column; gap: .1rem;
    padding: .75rem 1rem; border-radius: 14px;
    background: var(--white); border: 1px solid var(--line);
    box-shadow: 0 20px 34px -18px rgb(8 12 28 / .38);
    animation: card-float2 6.5s ease-in-out infinite;
  }
  @keyframes card-float2 { 50% { transform: translateY(-8px); } }
  .hero-stat strong { font-size: 1.5rem; font-weight: 780; letter-spacing: -.03em; color: var(--blue-dark); line-height: 1; }
  .hero-stat strong small { font-size: .8rem; color: var(--text-muted); }
  .hero-stat span { color: var(--text-muted); font-size: .66rem; }

  @media (max-width: 980px) {
    .hero-layout { grid-template-columns: 1fr; min-height: 0; padding-top: 3.5rem; }
    .hero-copy { max-width: 46rem; }
    .hero-stage { max-width: 34rem; }
  }

  @media (max-width: 600px) {
    h1 { font-size: clamp(2.5rem, 11vw, 3.6rem); }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .hero-primary, .hero-secondary { justify-content: center; }
    .run-item { grid-template-columns: 1fr; gap: .3rem; padding: .8rem 1.05rem; }
    .hero-stat { left: auto; right: .5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .run-item { transition: none; }
    .hero-run-float, .hero-stat, .hero-aurora::before, .hero-aurora::after { animation: none; }
  }
</style>
