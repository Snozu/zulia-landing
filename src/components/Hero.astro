---
const brands = [
  { name: 'Envia.com', image: '/brands/envia.svg', width: 713, height: 203, slug: 'envia' },
  { name: 'Proveedora Farid', image: '/brands/farid.png', width: 1000, height: 307, slug: 'farid' },
  { name: 'Grupo Mont' },
  { name: 'Viga Metales y Reciclados', image: '/brands/viga.png', width: 1080, height: 407, slug: 'viga' },
  { name: 'Grupo Motomex', image: '/brands/grupo-motomex.png', width: 397, height: 83, slug: 'motomex' },
  { name: 'Kawasaki', image: '/brands/kawasaki.svg', width: 131, height: 36, slug: 'kawasaki' },
  { name: 'KYMCO', image: '/brands/kymco.png', width: 700, height: 123, slug: 'kymco' },
  { name: 'TVS Motor', image: '/brands/tvs.svg', width: 148, height: 27, slug: 'tvs' },
  { name: 'Triumph Motorcycles', image: '/brands/triumph.svg', width: 110, height: 23, slug: 'triumph' },
  { name: 'ikom', image: '/brands/ikom.png', width: 113, height: 57, slug: 'ikom' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="page-shell hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span></span> Consultoría de producto y tecnología · Monterrey</p>
      <h1 id="hero-title">De un problema complejo a un sistema <em>que trabaja.</em></h1>
      <p class="hero-lead">Diseñamos y construimos software, automatizaciones e inteligencia artificial para empresas que necesitan operar, vender o decidir mejor.</p>
      <div class="hero-actions">
        <a class="button-light" href="#contacto">Platiquemos del reto</a>
        <a class="hero-link" href="#productos">Ver sistemas en producción</a>
      </div>
      <dl class="hero-proof" aria-label="Experiencia de Haziel Zul">
        <div><dt>Experiencia</dt><dd>6+ años</dd></div>
        <div><dt>Alcance</dt><dd>Producto a producción</dd></div>
        <div><dt>Especialidad</dt><dd>Software · IA · Automatización</dd></div>
      </dl>
    </div>

    <div class="consulting-route" data-reveal aria-label="Ruta de consultoría: entender, decidir, construir y evolucionar">
      <div class="route-heading">
        <span>Cómo llevamos una idea a producción</span>
        <strong>Una ruta clara,<br />sin capas de intermediarios.</strong>
      </div>

      <div class="route-map" aria-hidden="true">
        <svg viewBox="0 0 520 520" role="img">
          <path class="route-shadow" d="M58 420 C145 420 112 270 223 270 S320 110 458 104" />
          <path class="route-line" d="M58 420 C145 420 112 270 223 270 S320 110 458 104" />
          <circle class="route-pulse" r="6">
            <animateMotion dur="6s" repeatCount="indefinite" path="M58 420 C145 420 112 270 223 270 S320 110 458 104" />
          </circle>
        </svg>
        <div class="route-node node-one"><i></i><span>Entender</span><small>Negocio y operación</small></div>
        <div class="route-node node-two"><i></i><span>Decidir</span><small>Alcance y arquitectura</small></div>
        <div class="route-node node-three"><i></i><span>Construir</span><small>Producto e integraciones</small></div>
        <div class="route-node node-four"><i></i><span>Evolucionar</span><small>Datos y aprendizaje</small></div>
      </div>

      <p class="route-footer"><span></span> Criterio senior durante todo el proyecto</p>
    </div>
  </div>

  <div class="credibility" data-reveal>
    <div class="page-shell credibility-inner">
      <p>Marcas y organizaciones para las que hemos construido</p>
      <div class="logo-viewport" aria-label="Marcas relacionadas con la experiencia profesional de Haziel Zul">
        <div class="logo-track">
          <div class="logo-set">
            {brands.map((brand) => brand.image
              ? <img class={`brand-${brand.slug}`} src={brand.image} alt={`Logotipo de ${brand.name}`} width={brand.width} height={brand.height} loading="lazy" decoding="async" />
              : <strong class:list={{ compact: brand.compact }}>{brand.name}</strong>
            )}
          </div>
          <div class="logo-set" aria-hidden="true">
            {brands.map((brand) => brand.image
              ? <img class={`brand-${brand.slug}`} src={brand.image} alt="" width={brand.width} height={brand.height} loading="lazy" decoding="async" />
              : <strong class:list={{ compact: brand.compact }}>{brand.name}</strong>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { overflow: hidden; background: var(--night); color: var(--night-text); }
  .hero-grid { display: grid; min-height: calc(100svh - 4.75rem); grid-template-columns: minmax(0, 1.12fr) minmax(23rem, .7fr); align-items: center; gap: clamp(3.5rem, 7vw, 7rem); padding-block: clamp(4.5rem, 8vw, 7rem); }
  .hero-copy { position: relative; z-index: 2; }
  .eyebrow { color: var(--night-muted); }
  .eyebrow span { width: .48rem; height: .48rem; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgb(36 184 121 / .14); }
  h1 { max-width: 10.5ch; margin: 0; font-size: clamp(3.8rem, 6.6vw, 6.9rem); font-weight: 570; letter-spacing: -.068em; line-height: .9; }
  h1 em { color: var(--night-accent); font-style: normal; font-weight: 570; }
  .hero-lead { max-width: 40rem; margin: 1.8rem 0 0; color: var(--night-muted); font-size: clamp(1rem, 1.4vw, 1.13rem); line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.3rem; margin-top: 2rem; }
  .hero-link { display: inline-flex; min-height: 3rem; align-items: center; gap: .65rem; color: var(--ink-soft); font-size: .76rem; font-weight: 680; text-decoration: none; }
  .hero-link:hover { color: var(--blue-dark); }
  .hero-proof { display: grid; width: fit-content; max-width: 100%; grid-template-columns: .55fr 1fr 1.35fr; gap: 1rem; margin: 3rem 0 0; padding: 1rem 1.2rem; border: 0; border-radius: 2rem; background: var(--night-glass); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .hero-proof div { min-width: 0; }
  .hero-proof dt { margin-bottom: .4rem; color: var(--night-subtle); font-size: .51rem; font-weight: 700; letter-spacing: .075em; text-transform: uppercase; }
  .hero-proof dd { margin: 0; color: var(--night-text); font-size: .65rem; font-weight: 620; line-height: 1.4; }

  .consulting-route { position: relative; min-height: 34rem; padding-left: clamp(1rem, 3vw, 3rem); }
  .route-heading { position: relative; z-index: 2; }
  .route-heading span { display: block; color: var(--night-subtle); font-size: .53rem; font-weight: 720; letter-spacing: .07em; text-transform: uppercase; }
  .route-heading strong { display: block; margin-top: .9rem; color: var(--night-text); font-size: clamp(1.25rem, 2vw, 1.65rem); font-weight: 530; letter-spacing: -.035em; line-height: 1.15; }
  .route-map { position: absolute; top: 4rem; right: 0; width: min(100%, 28rem); aspect-ratio: 1 / 1; }
  .route-map svg { width: 100%; height: 100%; overflow: visible; }
  .route-shadow, .route-line { fill: none; stroke-linecap: round; }
  .route-shadow { opacity: .18; stroke: var(--night-accent); stroke-width: 7; }
  .route-line { stroke: var(--night-accent); stroke-width: 2; }
  .route-pulse { fill: var(--night-accent); filter: drop-shadow(0 0 7px color-mix(in srgb, var(--night-accent) 72%, transparent)); }
  .route-node { position: absolute; display: grid; grid-template-columns: auto 1fr; gap: .2rem .65rem; }
  .route-node i { grid-row: 1 / 3; width: .72rem; height: .72rem; margin-top: .2rem; border: 2px solid var(--night-accent); border-radius: 50%; background: var(--night); box-shadow: 0 0 0 5px color-mix(in srgb, var(--night-accent) 12%, transparent); }
  .route-node span { color: var(--night-text); font-size: .7rem; font-weight: 700; }
  .route-node small { color: var(--night-subtle); font-size: .52rem; }
  .node-one { top: calc(80.77% - .56rem); left: calc(11.15% - .36rem); }
  .node-two { top: calc(51.92% - .56rem); left: calc(42.88% - .36rem); }
  .node-three { top: calc(36.39% - .56rem); left: calc(63.53% - .36rem); }
  .node-four { top: calc(20% - .56rem); left: calc(88.08% - .36rem); grid-template-columns: minmax(0, 1fr) auto; transform: translateX(calc(-100% + .72rem)); text-align: right; }
  .node-four i { grid-column: 2; grid-row: 1 / 3; }
  .node-four span, .node-four small { grid-column: 1; }
  .route-footer { position: absolute; right: 0; bottom: 0; left: clamp(2rem, 4vw, 4rem); display: flex; align-items: center; gap: .55rem; margin: 0; color: var(--night-subtle); font-size: .54rem; font-weight: 670; letter-spacing: .035em; text-transform: uppercase; }
  .route-footer span { width: .48rem; height: .48rem; border-radius: 50%; background: var(--night-accent); }

  .credibility { background: var(--night-soft); }
  .credibility-inner { display: grid; min-height: 8rem; grid-template-columns: 15rem 1fr; align-items: center; gap: 3rem; }
  .credibility p { margin: 0; color: var(--night-subtle); font-size: .6rem; font-weight: 650; letter-spacing: .035em; line-height: 1.5; text-transform: uppercase; }
  .logo-viewport { min-width: 0; overflow: hidden; mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
  .logo-track { display: flex; width: max-content; filter: grayscale(1); opacity: .68; animation: brand-rail 34s linear infinite; }
  .logo-track:hover { animation-play-state: paused; }
  .logo-set { display: flex; flex: none; align-items: center; gap: clamp(2rem, 4vw, 4.25rem); padding-right: clamp(2rem, 4vw, 4.25rem); }
  .logo-set img { width: auto; max-width: 8rem; height: 1.8rem; object-fit: contain; filter: var(--brand-mark-filter); }
  .logo-set .brand-viga { max-width: 7.2rem; height: 2rem; }
  .logo-set .brand-motomex { max-width: 8.6rem; height: 1.85rem; }
  .logo-set .brand-kawasaki { max-width: 7rem; }
  .logo-set .brand-kymco { max-width: 7.6rem; }
  .logo-set .brand-tvs { max-width: 6.6rem; }
  .logo-set .brand-triumph { max-width: 6.8rem; }
  .logo-set strong { color: var(--night-text); font-size: clamp(.8rem, 1.3vw, 1.02rem); font-weight: 680; letter-spacing: -.035em; white-space: nowrap; }
  .logo-set strong.compact { max-width: 9.5rem; font-size: .72rem; line-height: 1.05; white-space: normal; }

  @keyframes brand-rail { to { transform: translateX(-50%); } }

  @media (max-width: 1040px) {
    .hero-grid { min-height: 0; grid-template-columns: 1fr; }
    .hero-copy { max-width: 50rem; }
    .consulting-route { width: min(100%, 43rem); min-height: 31rem; justify-self: end; }
    .credibility-inner { grid-template-columns: 1fr; gap: 1.4rem; padding-block: 2rem; }
    .logo-viewport { width: 100%; }
  }

  @media (max-width: 620px) {
    .hero-grid { gap: 4rem; padding-block: 3.8rem 4.5rem; }
    h1 { font-size: clamp(3.25rem, 15vw, 4.7rem); }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .hero-actions a { width: 100%; justify-content: center; }
    .hero-proof { grid-template-columns: 1fr; }
    .consulting-route { width: 100%; min-height: 0; padding-left: 0; justify-self: stretch; }
    .route-heading { max-width: 28rem; }
    .route-map { position: relative; inset: auto; width: 100%; aspect-ratio: 1 / 1; margin-top: 1.5rem; }
    .route-map svg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
    .route-node { gap: .2rem .6rem; }
    .route-node i { position: relative; z-index: 1; }
    .route-node span { font-size: .72rem; }
    .route-node small { font-size: .54rem; line-height: 1.4; }
    .route-footer { position: static; margin: 1rem 0 0; font-size: .58rem; line-height: 1.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-pulse { display: none; }
    .logo-track { width: auto; animation: none; }
    .logo-set { flex-wrap: wrap; }
    .logo-set[aria-hidden="true"] { display: none; }
  }
</style>
