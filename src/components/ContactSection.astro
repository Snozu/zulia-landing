---
import LinkedinLogo from 'phosphor-astro/LinkedinLogoFill.astro';
import WhatsappLogo from 'phosphor-astro/WhatsappLogoFill.astro';

interface Props {
  heading?: string;
  selectedInterest?: string;
}

const {
  heading = '¿Qué quieres poner a trabajar?',
  selectedInterest = '',
} = Astro.props;

const interests = [
  'Probar Semilla para prospección B2B',
  'Definir un producto o sistema',
  'Construir software a medida',
  'Automatizar una operación',
  'Implementar agentes de IA',
  'Mejorar web, e-commerce o growth',
  'No lo tengo claro todavía',
];
---

<section id="contacto" class="section-pad contact" aria-labelledby="contact-title">
  <div class="page-shell contact-grid">
    <div class="contact-copy" data-reveal>
      <p class="eyebrow"><span></span> Primera conversación · sin pitch automático</p>
      <h2 id="contact-title">{heading}</h2>
      <p>Cuéntanos qué pasa hoy, qué resultado necesitas y por qué importa ahora. Te diremos con honestidad si ZulIA puede resolverlo y cuál sería el siguiente paso.</p>
      <div class="direct-links">
        <a href="https://wa.me/528122509882" target="_blank" rel="noreferrer"><WhatsappLogo width="18" height="18" /> WhatsApp</a>
        <a href="https://www.linkedin.com/in/haziel-eduardo-zul-mendez-53b82b131/" target="_blank" rel="noreferrer"><LinkedinLogo width="18" height="18" /> LinkedIn</a>
      </div>
    </div>

    <form id="brief-form" class="brief-form" data-reveal>
      <div class="form-head"><strong>Empecemos por el contexto</strong><span>Respondemos personalmente</span></div>
      <div class="field-grid">
        <label for="nombre">Tu nombre<input id="nombre" name="nombre" type="text" autocomplete="name" required placeholder="Nombre y apellido" /></label>
        <label for="empresa">Empresa<input id="empresa" name="empresa" type="text" autocomplete="organization" placeholder="Empresa o proyecto" /></label>
      </div>
      <label for="interes">¿Qué quieres resolver?
        <select id="interes" name="interes" required>
          <option value="" disabled selected={!selectedInterest}>Selecciona una opción</option>
          {interests.map((interest) => <option selected={selectedInterest === interest}>{interest}</option>)}
        </select>
      </label>
      <label for="reto">Cuéntanos el problema<textarea id="reto" name="reto" required rows="5" placeholder="Qué sucede hoy, a quién afecta y qué debería cambiar."></textarea></label>
      <button type="submit">Enviar contexto por WhatsApp</button>
      <p class="form-note">Sin CRM invasivo. Tus datos sólo se usan para responderte.</p>
    </form>
  </div>
</section>

<style>
  .contact { position: relative; isolation: isolate; overflow: hidden; background: radial-gradient(circle at 10% 15%, var(--contact-glow-one) 0, transparent 32%), radial-gradient(circle at 88% 84%, var(--contact-glow-two) 0, transparent 31%), var(--contact-base); color: var(--contact-text); }
  .contact::before { position: absolute; z-index: -1; right: -8rem; bottom: -10rem; width: 34rem; height: 28rem; border-radius: 44% 56% 62% 38% / 55% 41% 59% 45%; background: rgb(255 255 255 / .08); filter: blur(4px); content: ''; transform: rotate(-8deg); }
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .contact .eyebrow { color: var(--contact-muted); }
  .contact .eyebrow span { width: .45rem; height: .45rem; border-radius: 50%; background: white; box-shadow: 0 0 0 4px rgb(255 255 255 / .14); }
  .contact h2 { max-width: 10ch; margin: 0; font-size: clamp(3.6rem, 7vw, 7rem); font-weight: 690; letter-spacing: -.08em; line-height: .88; }
  .contact-copy > p:not(.eyebrow) { max-width: 36rem; margin: 1.5rem 0 0; color: var(--contact-muted); font-size: .9rem; line-height: 1.75; }
  .direct-links { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
  .direct-links a { display: inline-flex; align-items: center; gap: .5rem; padding: .75rem 1rem; border: 1px solid rgb(255 255 255 / .4); border-radius: 1.5rem; background: rgb(255 255 255 / .1); color: white; font-size: .67rem; font-weight: 700; text-decoration: none; box-shadow: inset 0 1px 0 rgb(255 255 255 / .16); backdrop-filter: blur(16px); transition: background 180ms ease, color 180ms ease; }
  .direct-links a:hover { background: white; color: #090a0c; }
  .brief-form { padding: clamp(1.3rem, 4vw, 2.7rem); border: 1px solid rgb(255 255 255 / .42); border-radius: 2.3rem 2.3rem 4.5rem 2.3rem; background: color-mix(in srgb, var(--white) 80%, transparent); box-shadow: 0 28px 80px rgb(13 32 89 / .28), inset 0 1px 0 rgb(255 255 255 / .6); color: var(--ink); backdrop-filter: blur(28px) saturate(145%); }
  .form-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .form-head strong { font-size: 1.25rem; letter-spacing: -.04em; }
  .form-head span { color: var(--blue); font-size: .48rem; font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; }
  label { display: grid; gap: .42rem; margin-bottom: .85rem; color: var(--ink-soft); font-size: .62rem; font-weight: 720; }
  input, select, textarea { width: 100%; border: 1px solid var(--line); border-radius: 1.2rem; background: color-mix(in srgb, var(--paper) 76%, transparent); color: var(--ink); font: inherit; font-size: .76rem; transition: border 150ms ease, background 150ms ease; }
  input, select { min-height: 3.1rem; padding: .7rem .8rem; }
  textarea { padding: .8rem; resize: vertical; }
  input:focus, select:focus, textarea:focus { border-color: var(--blue); background: var(--white); }
  button { display: flex; width: 100%; min-height: 3.35rem; align-items: center; justify-content: center; gap: .65rem; border: 0; border-radius: 1.7rem; background: var(--ink); color: var(--paper); cursor: pointer; font: inherit; font-size: .72rem; font-weight: 740; box-shadow: 0 10px 28px rgb(0 0 0 / .2), inset 0 1px 0 rgb(255 255 255 / .16); transition: background 180ms ease, transform 180ms ease; }
  button:hover { background: var(--accent-surface-hover); color: white; transform: translateY(-2px); }
  .form-note { margin: .8rem 0 0; color: var(--text-muted); font-size: .48rem; text-align: center; text-transform: uppercase; }

  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .contact-grid { gap: 3rem; }
    .field-grid { grid-template-columns: 1fr; }
    .form-head { align-items: flex-start; flex-direction: column; }
    .brief-form { padding: 1.25rem; border-radius: 2rem 2rem 3.5rem 2rem; }
    .direct-links a { flex: 1; justify-content: center; }
  }
  @media (prefers-reduced-transparency: reduce) { .direct-links a { backdrop-filter: none; } .brief-form { background: var(--white); backdrop-filter: none; } }
</style>

<script>
  import { trackOutbound } from '../lib/analytics';

  const form = document.querySelector<HTMLFormElement>('#brief-form');
  const interestSelect = form?.querySelector<HTMLSelectElement>('#interes');

  document.querySelectorAll<HTMLAnchorElement>('[data-contact-interest]').forEach((link) => {
    link.addEventListener('click', () => {
      const interest = link.dataset.contactInterest;
      if (interest && interestSelect) interestSelect.value = interest;
    });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const message = [
      'Hola, quiero revisar un caso con ZulIA.',
      '',
      `Nombre: ${data.get('nombre') ?? ''}`,
      data.get('empresa') ? `Empresa: ${data.get('empresa')}` : '',
      `Qué quiero resolver: ${data.get('interes') ?? ''}`,
      `Contexto: ${data.get('reto') ?? ''}`,
    ].filter(Boolean).join('\n');

    trackOutbound('generate_lead', {
      form_id: 'brief-form',
      channel: 'whatsapp',
      interest: String(data.get('interes') ?? ''),
      has_company: Boolean(data.get('empresa')),
      page_path: window.location.pathname,
    });

    window.open(`https://wa.me/528122509882?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
  });
</script>
