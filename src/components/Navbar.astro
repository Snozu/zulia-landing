---
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import List from 'phosphor-astro/ListBold.astro';
import X from 'phosphor-astro/XBold.astro';
import CaretDown from 'phosphor-astro/CaretDownBold.astro';
import { NAV, CTA } from '../data/site';
import { services } from '../data/services';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="shell bar">
    <a class="brand" href="/" aria-label="ZulIA, inicio">
      <Wordmark height={20} />
    </a>

    <nav class="links" aria-label="Principal">
      {NAV.map((item) =>
        item.href === '/servicios/' ? (
          <div class="has-menu" data-submenu>
            <button
              class="parent"
              type="button"
              aria-expanded="false"
              aria-controls="menu-servicios"
              aria-current={isActive(item.href) ? 'page' : undefined}
              data-submenu-btn
            >
              {item.label}
              <CaretDown class="caret" width="12" height="12" aria-hidden="true" />
            </button>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ),
      )}
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="btn cta" href={CTA.primaryHref}>{CTA.primary}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Abrir menú</span>
        <List class="menu-open" width="20" height="20" aria-hidden="true" />
        <X class="menu-close" width="20" height="20" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="mega" id="menu-servicios" data-submenu-panel hidden inert>
    <div class="shell mega-inner">
      <p class="label mega-eyebrow">Siete formas de trabajar con nosotros</p>
      <div class="mega-grid">
        {services.map((s) => (
          <a class="mega-item" href={`/servicios/${s.slug}/`}>
            <span class="mega-nombre">{s.name}</span>
            <span class="mega-promesa">{s.promise}</span>
          </a>
        ))}
        <a class="mega-item mega-ayuda" href={CTA.primaryHref}>
          <span class="mega-nombre">¿No sabes cuál es el tuyo?</span>
          <span class="mega-promesa">Cuéntanos qué te está costando tiempo y te decimos por dónde empezar.</span>
        </a>
      </div>
      <div class="mega-pie">
        <a class="link" href="/servicios/">Ver todos los servicios</a>
        <p class="muted">La primera asesoría es de <strong>treinta minutos y sin costo</strong>.</p>
      </div>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden data-mobile-menu>
    <nav class="shell" aria-label="Principal móvil">
      {NAV.map((item) =>
        item.href === '/servicios/' ? (
          <div class="m-group">
            <button class="m-toggle" type="button" aria-expanded="false" aria-controls="m-servicios" data-msub-btn>
              <span>{item.label}</span>
              <CaretDown width="14" height="14" aria-hidden="true" />
            </button>
            <ul class="sub" id="m-servicios" hidden data-msub-panel>
              {services.map((s) => (
                <li><a href={`/servicios/${s.slug}/`}>{s.name}</a></li>
              ))}
              <li><a class="sub-all" href={item.href}>Ver todos los servicios</a></li>
            </ul>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ),
      )}
      <a class="btn" href={CTA.primaryHref}>{CTA.primary}</a>
    </nav>
  </div>
</header>

<script>
  // Services disclosure in the desktop bar.
  const sub = document.querySelector<HTMLElement>('[data-submenu]');
  const mega = document.querySelector<HTMLElement>('[data-submenu-panel]');
  const cabecera = document.querySelector<HTMLElement>('[data-header]');
  if (sub && mega && cabecera) {
    const subBtn = sub.querySelector<HTMLButtonElement>('[data-submenu-btn]')!;
    const setOpen = (open: boolean) => {
      subBtn.setAttribute('aria-expanded', String(open));
      sub.toggleAttribute('data-open', open);
      cabecera.toggleAttribute('data-mega', open);
      // `hidden` decide si existe y `inert` lo saca del tabulador. La entrada
      // se anima con @keyframes: una transición de visibility se quedaba a
      // medias y el panel se veía abierto pero no recibía clics.
      mega.toggleAttribute('hidden', !open);
      mega.toggleAttribute('inert', !open);
    };
    // Opens only when asked for: click or keyboard, never on hover.
    subBtn.addEventListener('click', () => setOpen(subBtn.getAttribute('aria-expanded') !== 'true'));
    // El foco tambien se va del boton hacia el panel: al hacer clic en un
    // servicio, `relatedTarget` es ese enlace. Si aqui no se cuenta el panel,
    // el menu se cierra durante el mousedown, el enlace deja de existir y el
    // clic nunca llega a navegar. Sin relatedTarget lo resuelve el clic de
    // documento de mas abajo.
    sub.addEventListener('focusout', (e) => {
      const destino = e.relatedTarget as Node | null;
      if (!destino) return;
      if (!sub.contains(destino) && !mega.contains(destino)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && subBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        subBtn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      const dentro = sub.contains(e.target as Node) || mega.contains(e.target as Node);
      if (!dentro) setOpen(false);
    });
    mega.addEventListener('focusout', (e) => {
      const destino = e.relatedTarget as Node | null;
      if (destino && !mega.contains(destino) && !sub.contains(destino)) setOpen(false);
    });
  }

  // Services accordion inside the mobile panel: expands and collapses on tap.
  const mBtn = document.querySelector<HTMLButtonElement>('[data-msub-btn]');
  const mPanel = document.querySelector<HTMLElement>('[data-msub-panel]');
  mBtn?.addEventListener('click', () => {
    const open = mBtn.getAttribute('aria-expanded') === 'true';
    mBtn.setAttribute('aria-expanded', String(!open));
    if (mPanel) mPanel.hidden = open;
  });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    header?.toggleAttribute('data-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    min-height: var(--nav-h);
  }
  .brand { display: inline-flex; align-items: center; color: var(--ink); text-decoration: none; }
  .links { display: flex; justify-content: center; gap: 1.75rem; }
  .links a {
    color: var(--ink-soft);
    font-size: .92rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: .25rem;
    border-bottom: 1px solid transparent;
  }
  .links a:hover { color: var(--ink); }
  .links a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
  /* Services disclosure */
  .has-menu { position: relative; display: flex; align-items: center; gap: .3rem; }
  .has-menu .parent { padding-right: 0; }
  .parent {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .25rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: .92rem;
    font-weight: 500;
    cursor: pointer;
  }
  .parent:hover { color: var(--ink); }
  .has-menu[data-open] .parent { color: var(--ink); }
  .parent :global(.caret) { color: var(--text-muted); transition: transform 200ms ease, color 160ms ease; }
  .has-menu[data-open] .parent :global(.caret) { transform: rotate(180deg); color: var(--ink); }
  /* Mega menú: una franja de ancho completo bajo la barra, no un globito
     colgando del item. Con seis servicios y su promesa, 30rem no alcanzaban
     para distinguirlos en una pantalla grande. Patrón de Stripe. */
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 1;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow-lg);
    animation: megaEntra 220ms cubic-bezier(.22, 1, .36, 1);
  }

  @keyframes megaEntra {
    from { opacity: 0; transform: translateY(-.5rem); }
    to { opacity: 1; transform: none; }
  }

  .mega-inner { padding-block: 2.25rem 1.75rem; }
  .mega-eyebrow { margin-bottom: 1.25rem; }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }

  /* Padding igual en las cuatro celdas y la rejilla desplazada hacia afuera:
     así el texto sigue alineado con el resto de la página y el relleno del
     hover cae parejo dentro de las líneas, en vez de correrse. */
  .mega-grid { margin-inline: -1.25rem; }

  .mega-item {
    display: grid;
    gap: .3rem;
    align-content: start;
    padding: 1.35rem 1.25rem;
    border-bottom: 0;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .mega-grid > * + * { border-left: 1px solid var(--line); }
  .mega-grid > :nth-child(n + 5) { border-top: 1px solid var(--line); }
  .mega-grid > :nth-child(4n + 1) { border-left: 0; }

  /* La octava celda no es un servicio: es la salida para quien llegó al menú
     sin saber qué pedir. Además cuadra la reja, que con siete quedaba coja. */
  .mega-ayuda .mega-nombre { color: var(--blue-dark); }

  @media (max-width: 1180px) {
    .mega-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mega-grid > :nth-child(n + 3) { border-top: 1px solid var(--line); }
    .mega-grid > :nth-child(2n + 1) { border-left: 0; }
    .mega-grid > :nth-child(2n) { border-left: 1px solid var(--line); }
  }

  .mega-item:hover { background: var(--white); }
  .mega-item:hover .mega-nombre { color: var(--blue-dark); }

  .mega-nombre {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 640;
    letter-spacing: -.015em;
    transition: color 160ms ease;
  }

  .mega-promesa { color: var(--text-muted); font-size: .88rem; line-height: 1.5; }

  .mega-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .mega-pie p { font-size: .88rem; }
  .mega-pie strong { color: var(--ink); }

  /* Cada item entra escalonado al abrir: da la sensación de que el menú se
     despliega, no de que aparece de golpe. */
  .mega-item {
    animation: entraItem 320ms cubic-bezier(.22, 1, .36, 1) backwards;
  }
  .mega-item:nth-child(1) { animation-delay: 20ms; }
  .mega-item:nth-child(2) { animation-delay: 50ms; }
  .mega-item:nth-child(3) { animation-delay: 80ms; }
  .mega-item:nth-child(4) { animation-delay: 110ms; }
  .mega-item:nth-child(5) { animation-delay: 140ms; }
  .mega-item:nth-child(6) { animation-delay: 170ms; }
  .mega-item:nth-child(7) { animation-delay: 200ms; }
  .mega-item:nth-child(8) { animation-delay: 230ms; }

  @keyframes entraItem {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega,
    .mega-item { animation: none; }
  }

  .actions { display: flex; align-items: center; gap: .75rem; }
  .cta { min-height: 2.5rem; padding: .6rem 1rem; font-size: .875rem; }
  :global(.theme-toggle) {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    height: 2.5rem;
    padding: 0 .55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--text-muted);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }
  :global(.theme-toggle svg) { width: .95rem; height: .95rem; }
  :global(.theme-toggle .theme-thumb) { display: none; }
  :global(.theme-toggle[data-state="light"] .theme-sun) { color: var(--ink); }
  :global(.theme-toggle[data-state="dark"] .theme-moon) { color: var(--ink); }
  :global(.theme-toggle:hover) { border-color: var(--ink); }

  /* Same garment as the theme toggle so the two controls read as a pair. */
  .menu-btn {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }
  .menu-btn:hover { border-color: var(--ink); }
  .menu-btn :global(svg) { display: block; }
  .menu-btn :global(.menu-close) { display: none; }
  .site-header[data-open] .menu-btn :global(.menu-open) { display: none; }
  .site-header[data-open] .menu-btn :global(.menu-close) { display: block; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .mobile { border-top: 1px solid var(--line); background: var(--paper); }
  .mobile nav { display: grid; gap: 0; padding-block: .5rem 1.25rem; }
  .mobile nav a:not(.btn) {
    padding: .9rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
  }
  .mobile nav .btn { margin-top: 1rem; }
  .m-group { display: grid; }
  .m-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: .9rem 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .m-toggle[aria-expanded="true"] { border-bottom-color: transparent; }
  .m-toggle svg { flex: 0 0 auto; color: var(--text-muted); transition: transform 180ms ease; }
  .m-toggle[aria-expanded="true"] svg { transform: rotate(180deg); color: var(--ink); }
  /* Sub-items read as a group: indented and muted, with no per-row rules —
     a border on each one turned the list into a broken table. */
  .sub {
    margin: 0;
    padding: .15rem 0 .8rem 1rem;
    list-style: none;
    display: grid;
    border-bottom: 1px solid var(--line);
  }
  .mobile nav .sub a {
    display: block;
    padding: .5rem 0;
    border: 0;
    color: var(--text-muted);
    font-size: .97rem;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }
  .mobile nav .sub a:hover { color: var(--ink); }
  .mobile nav .sub .sub-all { margin-top: .3rem; color: var(--blue-dark); font-weight: 600; }

  @media (max-width: 900px) {
    .bar { grid-template-columns: auto 1fr; gap: 1rem; }
    .links { display: none; }
    .actions { justify-self: end; }
    .cta { display: none; }
    .menu-btn { display: grid; }
  }
</style>
