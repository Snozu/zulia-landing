---
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, CTA } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="shell bar">
    <a class="brand" href="/" aria-label="ZulIA, inicio">
      <Wordmark height={20} />
    </a>

    <nav class="links" aria-label="Principal">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="btn cta" href={CTA.primaryHref}>{CTA.primary}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Abrir menú</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden data-mobile-menu>
    <nav class="shell" aria-label="Principal móvil">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn" href={CTA.primaryHref}>{CTA.primary}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    header?.toggleAttribute('data-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    min-height: var(--nav-h);
  }
  .brand { display: inline-flex; align-items: center; color: var(--ink); text-decoration: none; }
  .links { display: flex; justify-content: center; gap: 1.75rem; }
  .links a {
    color: var(--ink-soft);
    font-size: .92rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: .25rem;
    border-bottom: 1px solid transparent;
  }
  .links a:hover { color: var(--ink); }
  .links a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
  .actions { display: flex; align-items: center; gap: .75rem; }
  .cta { min-height: 2.5rem; padding: .6rem 1rem; font-size: .875rem; }
  :global(.theme-toggle) {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    height: 2.5rem;
    padding: 0 .55rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  :global(.theme-toggle svg) { width: .95rem; height: .95rem; }
  :global(.theme-toggle .theme-thumb) { display: none; }
  :global(.theme-toggle[data-state="light"] .theme-sun) { color: var(--ink); }
  :global(.theme-toggle[data-state="dark"] .theme-moon) { color: var(--ink); }
  :global(.theme-toggle:hover) { border-color: var(--ink); }

  .menu-btn {
    display: none;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
  }
  .menu-btn i {
    position: absolute;
    left: .6rem;
    right: .6rem;
    height: 1.5px;
    background: var(--ink);
    transition: transform 160ms ease;
  }
  .menu-btn i:first-child { top: .9rem; }
  .menu-btn i:last-child { bottom: .9rem; }
  .site-header[data-open] .menu-btn i:first-child { transform: translateY(.3rem) rotate(45deg); }
  .site-header[data-open] .menu-btn i:last-child { transform: translateY(-.3rem) rotate(-45deg); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .mobile { border-top: 1px solid var(--line); background: var(--paper); }
  .mobile nav { display: grid; gap: 0; padding-block: .5rem 1.25rem; }
  .mobile nav a:not(.btn) {
    padding: .9rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
  }
  .mobile nav .btn { margin-top: 1rem; }

  @media (max-width: 900px) {
    .bar { grid-template-columns: auto 1fr; gap: 1rem; }
    .links { display: none; }
    .actions { justify-self: end; }
    .cta { display: none; }
    .menu-btn { display: inline-block; }
  }
</style>
