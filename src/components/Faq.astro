---
import { faqs } from '../data/faqs';
import CaretDown from 'phosphor-astro/CaretDownBold.astro';
---

<section class="section-pad faq" aria-labelledby="faq-title">
  <div class="page-shell faq-grid" data-reveal>
    <header><p class="kicker">Antes de comenzar</p><h2 id="faq-title" class="section-title">Preguntas sin letra pequeña.</h2><p>Si tu caso no cabe aquí, probablemente vale la pena revisarlo directamente.</p></header>
    <div class="questions">
      {faqs.map((faq, index) => (
        <details class="question" name="preguntas-zulia">
          <summary class="question-trigger"><strong>{faq.q}</strong><CaretDown class="faq-caret" width="18" height="18" aria-hidden="true" /></summary>
          <div class="question-content"><p>{faq.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--white); }
  .faq-grid { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(3rem, 8vw, 8rem); }
  .faq header > p:last-child { max-width: 24rem; margin: 1.5rem 0 0; color: var(--text-muted); font-size: 0.82rem; line-height: 1.65; }
  :global(.questions) { display: grid; gap: .65rem; }
  :global(.question) { overflow: hidden; border: 0; border-radius: 1.6rem; background: var(--glass); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  :global(.question-trigger) { display: grid; width: 100%; min-height: 4.8rem; grid-template-columns: 1fr 1.5rem; align-items: center; gap: 1rem; padding: 1rem 1.2rem; border: 0; border-radius: 0; background: transparent; color: var(--ink); text-align: left; box-shadow: none; }
  :global(.question-trigger::-webkit-details-marker) { display: none; }
  :global(.question-trigger::marker) { content: ''; }
  :global(.question-trigger:hover) { background: color-mix(in srgb, var(--blue-soft) 38%, transparent); color: var(--blue-dark); }
  :global(.question-trigger strong) { font-family: var(--font-display); font-size: 1.08rem; letter-spacing: -0.025em; }
  :global(.question[open] .faq-caret) { transform: rotate(180deg); }
  :global(.faq-caret) { transition: transform 180ms ease; }
  :global(.question-content p) { max-width: 45rem; margin: 0; padding: 0 3.5rem 1.4rem 1.2rem; color: var(--text-muted); font-size: 0.82rem; line-height: 1.7; }
  @media (max-width: 820px) { .faq-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    :global(.question) { border-radius: 1.35rem; }
    :global(.question-trigger) { min-height: 4.4rem; padding: 1rem 1.1rem; }
    :global(.question-content p) { padding: 0 1.1rem 1.25rem; }
  }
</style>
