---
import Brain from 'phosphor-astro/BrainBold.astro';
import Check from 'phosphor-astro/CheckBold.astro';
import Code from 'phosphor-astro/CodeBold.astro';
import Compass from 'phosphor-astro/CompassBold.astro';
import Database from 'phosphor-astro/DatabaseBold.astro';
import MagnifyingGlass from 'phosphor-astro/MagnifyingGlassBold.astro';
import PlugsConnected from 'phosphor-astro/PlugsConnectedBold.astro';

interface Props { slug: string; }

const { slug } = Astro.props;

const labels: Record<string, string> = {
  'desarrollo-software-a-medida': 'Una operación, no otra herramienta aislada',
  'agentes-inteligencia-artificial': 'Contexto suficiente para decidir y actuar',
  'automatizacion-procesos': 'El trabajo avanza entre tus sistemas',
  'landing-pages-seo': 'Visible en buscadores, respuestas y agentes',
  'consultoria-arquitectura-tecnologica': 'Decidir qué construir antes de pagarlo',
};
---

<section class={`service-visual visual-${slug}`} aria-label={labels[slug]}>
  <header class="visual-head">
    <p><span></span> Escena del resultado</p>
    <strong>{labels[slug]}</strong>
  </header>

  {slug === 'desarrollo-software-a-medida' && (
    <div class="visual-body software-scene">
      <div class="system-request">
        <span>Entrada</span>
        <strong>Nueva orden</strong>
        <small>Cliente · 10:42</small>
      </div>
      <div class="system-line"><i></i><i></i><i></i></div>
      <div class="system-core">
        <div class="core-title"><Code width="18" height="18" /><span><small>Sistema operativo</small><strong>Operación central</strong></span><em>LIVE</em></div>
        <ul>
          <li><span>Inventario</span><strong>Validado</strong></li>
          <li><span>Pago</span><strong>Confirmado</strong></li>
          <li><span>Entrega</span><strong>Asignada</strong></li>
        </ul>
      </div>
      <div class="system-result">
        <span>Resultado</span>
        <strong>Orden #2841 lista</strong>
        <small>3 sistemas sincronizados</small>
      </div>
      <div class="system-caption"><Database width="14" height="14" /><span>Una fuente de verdad para clientes, equipo y dirección.</span></div>
    </div>
  )}

  {slug === 'agentes-inteligencia-artificial' && (
    <div class="visual-body agent-scene">
      <div class="agent-orbit">
        <div class="agent-center"><Brain width="25" height="25" /><strong>Agente</strong><small>Objetivo + límites</small></div>
        <span class="orbit-node source">Documentación</span>
        <span class="orbit-node memory">Memoria</span>
        <span class="orbit-node tools">Herramientas</span>
        <span class="orbit-node human">Aprobación humana</span>
        <i class="agent-pulse"></i>
      </div>
      <div class="agent-log">
        <p><span>10:42:03</span> Detecté la intención y reuní contexto.</p>
        <p><span>10:42:05</span> Validé reglas, permisos y disponibilidad.</p>
        <p class="active"><span>10:42:06</span> Acción preparada para confirmar.</p>
        <div><small>Decisión solicitada</small><strong>¿Confirmamos la operación?</strong><span class="demo-action">Confirmar</span></div>
      </div>
    </div>
  )}

  {slug === 'automatizacion-procesos' && (
    <div class="visual-body automation-scene">
      <svg class="workflow-lines" viewBox="0 0 900 300" aria-hidden="true">
        <path d="M90 150 C180 150 168 70 275 70 S390 150 465 150 S565 235 665 235 S730 120 820 120" />
        <circle r="7"><animateMotion dur="5.5s" repeatCount="indefinite" path="M90 150 C180 150 168 70 275 70 S390 150 465 150 S565 235 665 235 S730 120 820 120" /></circle>
      </svg>
      <div class="workflow-node wf-one"><span>01</span><PlugsConnected width="18" height="18" /><p><small>Webhook</small><strong>Nuevo prospecto</strong></p></div>
      <div class="workflow-node wf-two"><span>02</span><Brain width="18" height="18" /><p><small>Clasificar</small><strong>Evaluar oportunidad</strong></p></div>
      <div class="workflow-node wf-three"><span>03</span><Database width="18" height="18" /><p><small>CRM</small><strong>Crear y asignar</strong></p></div>
      <div class="workflow-node wf-four"><span>04</span><Check width="18" height="18" /><p><small>Seguimiento</small><strong>Avisar al equipo</strong></p></div>
      <p class="workflow-status"><i></i> Flujo observable · con reintentos y alertas</p>
    </div>
  )}

  {slug === 'landing-pages-seo' && (
    <div class="visual-body growth-scene">
      <div class="growth-orb orb-one"></div><div class="growth-orb orb-two"></div>
      <div class="search-query"><MagnifyingGlass width="17" height="17" /><span>¿Quién puede resolver este problema en México?</span><kbd>Buscar</kbd></div>
      <div class="search-result answer-glass">
        <small><i></i> Respuesta fundamentada</small>
        <strong>Tu empresa aparece como una opción clara, verificable y relevante.</strong>
        <p>La oferta, la experiencia y el siguiente paso se pueden entender sin adivinar.</p>
        <div class="answer-proof"><span>Entidad clara</span><span>Evidencia visible</span><span>Acción disponible</span></div>
      </div>
      <div class="surface-chip chip-search"><small>Descubrimiento</small><strong>Google + Bing</strong></div>
      <div class="surface-chip chip-ai"><small>Respuesta</small><strong>IA generativa</strong></div>
      <div class="surface-chip chip-agent"><small>Comparación</small><strong>Búsqueda agéntica</strong></div>
      <div class="growth-path"><span>Encontrar</span><i></i><span>Entender</span><i></i><span>Elegir</span></div>
      <div class="web-vitals"><span><strong>✓</strong> Indexable</span><span><strong>✓</strong> Citable</span><span><strong>✓</strong> Medible</span></div>
    </div>
  )}

  {slug === 'consultoria-arquitectura-tecnologica' && (
    <div class="visual-body strategy-scene">
      <div class="decision-context">
        <Compass width="22" height="22" />
        <span><small>Decisión actual</small><strong>¿Cómo resolvemos este cuello de botella?</strong></span>
      </div>
      <div class="decision-options">
        <span>Comprar<small>Rápido · poco control</small></span>
        <span class="selected">Integrar<small>Mejor balance ahora</small><Check width="14" height="14" /></span>
        <span>Construir<small>Control · mayor inversión</small></span>
        <span>No cambiar<small>Costo operativo actual</small></span>
      </div>
      <div class="decision-basis"><small>La recomendación considera</small><span>Tiempo</span><span>Riesgo</span><span>Datos</span><span>Dependencias</span><span>Costo de cambio</span></div>
      <p class="decision-output"><i></i><span><small>Siguiente paso defendible</small><strong>Integrar primero. Construir sólo el núcleo diferenciador.</strong></span></p>
    </div>
  )}
</section>

<style>
  .service-visual { position: relative; isolation: isolate; margin-top: clamp(3rem, 6vw, 5.5rem); overflow: hidden; padding: .7rem; border: 0; border-radius: clamp(2rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4.5rem) clamp(4rem, 10vw, 9rem) clamp(2rem, 5vw, 4.5rem); background: radial-gradient(circle at 80% 5%, color-mix(in srgb, var(--night-accent) 18%, transparent) 0, transparent 34%), radial-gradient(circle at 5% 90%, color-mix(in srgb, var(--blue) 12%, transparent) 0, transparent 33%), var(--night); color: var(--night-text); box-shadow: var(--glass-shadow); }
  .service-visual::before { position: absolute; z-index: -1; top: -11rem; right: 9%; width: 25rem; height: 25rem; border-radius: 42% 58% 64% 36% / 55% 42% 58% 45%; background: color-mix(in srgb, var(--night-accent) 18%, transparent); filter: blur(45px); content: ''; animation: liquid-drift 13s ease-in-out infinite alternate; }
  .visual-head { display: flex; min-height: 3.7rem; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1.1rem; border: 0; border-radius: 2rem; background: var(--night-glass); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--night-text) 10%, transparent); -webkit-backdrop-filter: blur(20px) saturate(140%); backdrop-filter: blur(20px) saturate(140%); }
  .visual-head p { display: flex; align-items: center; gap: .55rem; margin: 0; color: var(--night-subtle); font-size: .5rem; font-weight: 720; letter-spacing: .075em; text-transform: uppercase; }
  .visual-head p span { width: .46rem; height: .46rem; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgb(36 184 121 / .12); }
  .visual-head strong { color: var(--night-muted); font-size: .63rem; font-weight: 620; }
  .visual-body { position: relative; min-height: clamp(28rem, 45vw, 38rem); overflow: hidden; border-radius: 2.2rem 2.2rem clamp(3.4rem, 8vw, 7.8rem) 2.2rem; }

  .software-scene { display: grid; grid-template-columns: .72fr 1.15fr .72fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); padding: clamp(2rem, 6vw, 5rem); background-image: radial-gradient(var(--night-line) .7px, transparent .7px); background-size: 18px 18px; }
  .system-request, .system-result { position: relative; z-index: 2; display: grid; gap: .35rem; }
  .system-request span, .system-result span { color: var(--night-subtle); font-size: .48rem; font-weight: 720; letter-spacing: .07em; text-transform: uppercase; }
  .system-request strong, .system-result strong { font-size: clamp(1rem, 2vw, 1.45rem); font-weight: 590; letter-spacing: -.035em; }
  .system-request small, .system-result small { color: var(--night-subtle); font-size: .52rem; }
  .system-core { position: relative; z-index: 2; padding: 1.2rem; border: 0; border-radius: 1.5rem; background: var(--night-glass-strong); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(22px) saturate(145%); backdrop-filter: blur(22px) saturate(145%); }
  .core-title { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .7rem; padding-bottom: 1rem; border-bottom: 0; color: var(--night-accent); }
  .core-title span { display: grid; gap: .15rem; }
  .core-title small { color: var(--night-subtle); font-size: .42rem; text-transform: uppercase; }
  .core-title strong { color: var(--night-text); font-size: .7rem; }
  .core-title em { color: #52cb8e; font-size: .44rem; font-style: normal; font-weight: 750; }
  .system-core ul { margin: .5rem 0 0; padding: 0; list-style: none; }
  .system-core li { display: flex; justify-content: space-between; gap: 1rem; padding-block: .7rem; border-bottom: 0; font-size: .56rem; }
  .system-core li:last-child { border: 0; }
  .system-core li span { color: var(--night-muted); }
  .system-core li strong { color: var(--night-text); font-weight: 620; }
  .system-line { position: absolute; top: 50%; right: 14%; left: 14%; height: 1px; background: var(--night-accent); opacity: .52; }
  .system-line i { position: absolute; top: -.22rem; width: .45rem; height: .45rem; border-radius: 50%; background: var(--night-accent); animation: system-packet 4.5s linear infinite; }
  .system-line i:nth-child(2) { animation-delay: -1.5s; }.system-line i:nth-child(3) { animation-delay: -3s; }
  .system-caption { position: absolute; right: 2rem; bottom: 1.5rem; display: flex; align-items: center; gap: .5rem; color: var(--night-subtle); font-size: .5rem; }

  .agent-scene { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 8vw, 8rem); padding: clamp(2rem, 5vw, 4.5rem); }
  .agent-orbit { position: relative; width: min(100%, 28rem); aspect-ratio: 1; justify-self: center; border: 0; border-radius: 50%; box-shadow: inset 0 0 0 4.5rem color-mix(in srgb, var(--night-panel-soft) 72%, transparent); }
  .agent-center { position: absolute; inset: 50% auto auto 50%; display: grid; width: 8rem; height: 8rem; place-items: center; padding: 1rem; border: 0; border-radius: 50%; transform: translate(-50%, -50%); background: var(--night-panel); color: var(--night-accent); box-shadow: var(--glass-shadow); text-align: center; }
  .agent-center strong { margin-top: -.7rem; color: var(--night-text); font-size: .75rem; }.agent-center small { margin-top: -1.25rem; color: var(--night-subtle); font-size: .44rem; }
  .orbit-node { position: absolute; padding: .48rem .62rem; border: 0; border-radius: 1rem; background: var(--night-panel); color: var(--night-muted); box-shadow: var(--glass-shadow); font-size: .5rem; font-weight: 620; }
  .source { top: 5%; left: 38%; }.memory { top: 45%; right: -4%; }.tools { right: 15%; bottom: 5%; }.human { bottom: 14%; left: -3%; }
  .agent-pulse { position: absolute; top: 50%; left: 50%; width: .55rem; height: .55rem; border-radius: 50%; background: var(--night-accent); box-shadow: 0 0 14px color-mix(in srgb, var(--night-accent) 70%, transparent); transform-origin: -9rem 0; animation: agent-orbit 7s linear infinite; }
  .agent-log { border-top: 0; }
  .agent-log > p { display: grid; grid-template-columns: 4rem 1fr; gap: 1rem; margin: 0; padding-block: .9rem; border-bottom: 0; color: var(--night-muted); font-size: .57rem; line-height: 1.5; }
  .agent-log > p span { color: var(--night-accent); font-size: .48rem; font-weight: 700; }.agent-log > p.active { color: var(--night-text); }
  .agent-log > div { position: relative; display: grid; gap: .35rem; margin-top: 1.2rem; padding: 1rem 7rem 1rem 1rem; border: 0; border-radius: 1.25rem; background: var(--night-glass-strong); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); }
  .agent-log > div small { color: var(--night-subtle); font-size: .44rem; text-transform: uppercase; }.agent-log > div strong { font-size: .68rem; }
  .agent-log .demo-action { position: absolute; top: 50%; right: .8rem; padding: .55rem .7rem; border-radius: .3rem; transform: translateY(-50%); background: #5276b5; color: white; font-size: .46rem; font-weight: 700; }

  .automation-scene { min-height: 32rem; background-image: radial-gradient(var(--night-line) .7px, transparent .7px); background-size: 18px 18px; }
  .workflow-lines { position: absolute; inset: 4rem 5%; width: 90%; height: calc(100% - 8rem); overflow: visible; }.workflow-lines path { fill: none; stroke: var(--night-accent); stroke-width: 1.25; stroke-dasharray: 6 8; }.workflow-lines circle { fill: var(--night-accent); filter: drop-shadow(0 0 5px color-mix(in srgb, var(--night-accent) 70%, transparent)); }
  .workflow-node { position: absolute; z-index: 2; display: grid; width: 13rem; grid-template-columns: auto auto 1fr; align-items: center; gap: .65rem; padding: .8rem; border: 0; border-radius: 1.35rem; background: var(--night-glass-strong); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(20px) saturate(145%); backdrop-filter: blur(20px) saturate(145%); }
  .workflow-node > span { color: var(--night-subtle); font-size: .43rem; }.workflow-node > svg { color: var(--night-accent); }.workflow-node p { display: grid; gap: .15rem; margin: 0; }.workflow-node small { color: var(--night-subtle); font-size: .42rem; text-transform: uppercase; }.workflow-node strong { color: var(--night-text); font-size: .58rem; }
  .wf-one { top: 42%; left: 3%; }.wf-two { top: 12%; left: 29%; }.wf-three { top: 43%; left: 50%; }.wf-four { right: 3%; bottom: 13%; }
  .workflow-status { position: absolute; bottom: 1.2rem; left: 1.5rem; display: flex; align-items: center; gap: .5rem; margin: 0; color: var(--night-subtle); font-size: .48rem; text-transform: uppercase; }.workflow-status i { width: .44rem; height: .44rem; border-radius: 50%; background: var(--green); }

  .growth-scene { display: grid; align-content: center; padding: clamp(2rem, 6vw, 5rem) clamp(2rem, 9vw, 8rem); background: radial-gradient(circle at 17% 15%, rgb(91 133 201 / .23), transparent 25%), radial-gradient(circle at 88% 82%, rgb(76 181 167 / .14), transparent 28%); }
  .growth-orb { position: absolute; border-radius: 43% 57% 52% 48% / 59% 35% 65% 41%; filter: blur(2px); opacity: .62; animation: liquid-drift 10s ease-in-out infinite alternate; }
  .orb-one { top: 7%; right: 6%; width: 13rem; height: 10rem; background: linear-gradient(135deg, rgb(113 157 230 / .26), rgb(143 104 213 / .12)); box-shadow: inset 0 1px 1px rgb(255 255 255 / .18), 0 28px 70px rgb(41 72 126 / .25); }
  .orb-two { bottom: 4%; left: 4%; width: 9rem; height: 7rem; background: linear-gradient(145deg, rgb(91 202 183 / .18), rgb(75 104 164 / .2)); animation-delay: -4s; }
  .search-query { position: relative; z-index: 2; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .75rem; max-width: 47rem; padding: .85rem 1rem; border: 0; border-radius: 2rem; background: var(--night-glass-strong); box-shadow: var(--glass-shadow); color: var(--night-text); font-size: .65rem; -webkit-backdrop-filter: blur(22px) saturate(145%); backdrop-filter: blur(22px) saturate(145%); }
  .search-query kbd { color: var(--night-subtle); font: inherit; font-size: .46rem; text-transform: uppercase; }
  .search-result { position: relative; z-index: 2; max-width: 45rem; margin-top: 1.3rem; }.search-result small { display: flex; align-items: center; gap: .45rem; color: var(--night-accent); font-size: .48rem; text-transform: uppercase; }.search-result small i { width: .45rem; height: .45rem; border-radius: 50%; background: #70d3a2; box-shadow: 0 0 0 4px rgb(112 211 162 / .1); }.search-result strong { display: block; max-width: 28ch; margin-top: .65rem; font-size: clamp(1.55rem, 3.4vw, 3.3rem); font-weight: 570; letter-spacing: -.055em; line-height: 1.02; }.search-result p { color: var(--night-muted); font-size: .67rem; }
  .answer-glass { padding: clamp(1.25rem, 2.5vw, 2rem); border: 0; border-radius: 2rem 2rem 3.5rem 2rem; background: var(--night-glass-strong); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(26px) saturate(155%); backdrop-filter: blur(26px) saturate(155%); }
  .answer-proof { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1.2rem; padding-top: .9rem; border-top: 0; }.answer-proof span { color: var(--night-subtle); font-size: .46rem; text-transform: uppercase; }
  .surface-chip { position: absolute; z-index: 3; display: grid; gap: .2rem; padding: .7rem 1rem; border: 0; border-radius: 1.5rem; background: var(--night-glass-strong); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(20px) saturate(150%); backdrop-filter: blur(20px) saturate(150%); }
  .surface-chip small { color: var(--night-subtle); font-size: .4rem; text-transform: uppercase; }.surface-chip strong { font-size: .55rem; }
  .chip-search { top: 13%; right: 4%; transform: rotate(3deg); }.chip-ai { right: 2%; bottom: 32%; transform: rotate(-2deg); }.chip-agent { right: 12%; bottom: 12%; transform: rotate(2deg); }
  .growth-path { display: flex; align-items: center; gap: 1rem; margin-top: 2.5rem; color: var(--night-muted); font-size: .51rem; font-weight: 650; text-transform: uppercase; }.growth-path i { width: clamp(2rem, 7vw, 6rem); height: 1px; background: var(--night-accent); }
  .web-vitals { position: absolute; right: clamp(1.5rem, 5vw, 4rem); bottom: clamp(1.5rem, 4vw, 3rem); display: flex; gap: 1.5rem; }.web-vitals span { color: var(--night-subtle); font-size: .43rem; text-transform: uppercase; }.web-vitals strong { display: block; margin-bottom: .25rem; color: var(--night-text); font-size: .9rem; }

  .strategy-scene { display: grid; grid-template-columns: .8fr 1.2fr; align-content: center; gap: clamp(2rem, 7vw, 7rem); padding: clamp(2rem, 6vw, 5rem); }
  .decision-context { display: flex; align-items: flex-start; gap: .8rem; color: var(--night-accent); }.decision-context span { display: grid; gap: .5rem; }.decision-context small { color: var(--night-subtle); font-size: .46rem; text-transform: uppercase; }.decision-context strong { max-width: 17ch; color: var(--night-text); font-size: clamp(1.35rem, 2.8vw, 2.55rem); font-weight: 570; letter-spacing: -.045em; line-height: 1.08; }
  .decision-options { border-top: 0; }.decision-options > span { position: relative; display: grid; grid-template-columns: 1fr auto; gap: .25rem 1rem; padding: 1rem; border-bottom: 0; color: var(--night-muted); font-size: .68rem; }.decision-options small { grid-column: 1; color: var(--night-subtle); font-size: .45rem; }.decision-options .selected { border-left: 3px solid var(--night-accent); background: var(--night-glass-strong); color: var(--night-text); }.decision-options svg { grid-row: 1 / 3; grid-column: 2; align-self: center; color: #72d29f; }
  .decision-basis { grid-column: 1 / -1; display: flex; align-items: center; flex-wrap: wrap; gap: .6rem 1.2rem; padding-top: 1.2rem; border-top: 0; color: var(--night-muted); font-size: .48rem; }.decision-basis small { margin-right: .8rem; color: var(--night-subtle); text-transform: uppercase; }.decision-basis span::before { margin-right: .45rem; color: var(--night-accent); content: "•"; }
  .decision-output { grid-column: 1 / -1; display: flex; align-items: center; gap: .8rem; margin: .4rem 0 0; padding: 1rem; border-radius: 1.25rem; background: var(--night-glass-strong); }.decision-output i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 5px rgb(36 184 121 / .1); }.decision-output span { display: grid; gap: .2rem; }.decision-output small { color: var(--night-subtle); font-size: .43rem; text-transform: uppercase; }.decision-output strong { font-size: .65rem; }

  @keyframes system-packet { from { left: 0; } to { left: 100%; } }
  @keyframes agent-orbit { to { transform: rotate(1turn); } }
  @keyframes liquid-drift { to { transform: translate3d(1.5rem, 1rem, 0) rotate(8deg) scale(1.06); } }

  @media (max-width: 820px) {
    .visual-body { min-height: 34rem; }
    .software-scene, .agent-scene, .strategy-scene { grid-template-columns: 1fr; }
    .software-scene { align-content: center; gap: 1.5rem; }
    .system-line { top: 18%; bottom: 18%; left: 50%; width: 1px; height: auto; }.system-line i { left: -.22rem; animation: system-packet-vertical 4.5s linear infinite; }
    .system-request, .system-result { padding-left: 1rem; }.system-core { width: min(100%, 30rem); justify-self: center; }
    .agent-orbit { width: min(80vw, 21rem); }.agent-log { width: 100%; }
    .strategy-scene { align-content: start; }.decision-basis, .decision-output { grid-column: 1; }
    .wf-one { top: 9%; left: 4%; }.wf-two { top: 29%; right: 4%; left: auto; }.wf-three { top: 50%; left: 4%; }.wf-four { right: 4%; bottom: 8%; }.workflow-lines { display: none; }
    .growth-scene { background: radial-gradient(circle at 25% 8%, color-mix(in srgb, var(--night-accent) 20%, transparent), transparent 35%), var(--night); }.web-vitals { position: static; flex-wrap: wrap; margin-top: 2rem; }
    .surface-chip { display: none; }
  }

  @media (max-width: 520px) {
    .service-visual { padding: .4rem; border-radius: 2rem 2rem 4rem 2rem; }
    .visual-head { min-height: 0; align-items: flex-start; flex-direction: column; padding: 1rem; border-radius: 1.6rem; }
    .visual-head p { font-size: .6rem; }
