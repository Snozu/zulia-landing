---
// Google Analytics 4. The measurement ID is baked in at build time, so the
// Docker build has to receive PUBLIC_GA_ID as a --build-arg (see Dockerfile).
// Without an ID nothing is emitted at all: no script, no requests, no cookies.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
  gaId && (
    <>
      {/* La cola de dataLayer se arma de inmediato y no cuesta red: gtag.js la
          drena cuando llega. El script de Google son 71 KiB que en un celular
          compiten por el hilo principal justo cuando se esta pintando, asi que
          se carga en el primer gesto del visitante o cuando el navegador esta
          ocioso, lo que ocurra antes. No se pierde ni un page_view. */}
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, {
          // The landing is a static multi-page site: every route is a real
          // document load, so GA's automatic page_view is already correct.
          anonymize_ip: true,
        });

        (() => {
          let pedido = false;
          const cargar = () => {
            if (pedido) return;
            pedido = true;
            for (const href of ['https://www.googletagmanager.com', 'https://www.google-analytics.com']) {
              const pre = document.createElement('link');
              pre.rel = 'preconnect';
              pre.href = href;
              pre.crossOrigin = '';
              document.head.appendChild(pre);
            }
            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
          };

          const gestos = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
          const alGesto = () => {
            gestos.forEach((g) => window.removeEventListener(g, alGesto));
            cargar();
          };
          gestos.forEach((g) => window.addEventListener(g, alGesto, { passive: true, once: true }));

          // Red de seguridad: si nadie toca nada, se carga igual al quedar
          // ocioso, para no perder la visita de quien solo lee y se va.
          if ('requestIdleCallback' in window) requestIdleCallback(cargar, { timeout: 5000 });
          else setTimeout(cargar, 3000);
        })();
      </script>
      <script is:inline>
        // Delegated on document so it also covers links rendered later by the
        // React islands. Programmatic window.open calls (the WhatsApp forms)
        // don't fire a click on an anchor, so those track themselves.
        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (!link) return;

          const href = link.getAttribute('href') || '';
          let channel = '';
          if (href.includes('wa.me') || href.includes('api.whatsapp.com')) channel = 'whatsapp';
          else if (href.startsWith('mailto:')) channel = 'email';
          else if (href.startsWith('tel:')) channel = 'phone';
          else if (href.includes('linkedin.com')) channel = 'linkedin';
          if (!channel) return;

          window.gtag?.('event', 'contact_click', {
            channel,
            link_url: href,
            link_text: (link.textContent || '').trim().slice(0, 100),
            page_path: window.location.pathname,
            transport_type: 'beacon',
          });
        });
      </script>
    </>
  )
}
