---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const guias = (await getCollection('guias', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = 'Guías de precios y decisiones de tecnología en México | ZulIA';
const description =
  'Cuánto cuesta un chatbot de WhatsApp, una página web o un software a medida en México. Rangos reales, qué mueve el precio y qué exigir en una propuesta.';

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: guias.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://zulia.lat/guias/${g.id}/`,
    name: g.data.title,
  })),
};
---

<Layout title={title} description={description} jsonLd={listSchema}>
  <Navbar />
  <main id="contenido" class="guias">
    <section class="head escenario">
      <div class="shell grid">
        <div class="copy">
          <p class="esc-eyebrow">Guías</p>
          <h1 class="display">Lo que cuesta, antes de que te lo cotizen.</h1>
          <p class="lead">Rangos reales del mercado mexicano, qué hace que una propuesta suba o baje y qué puedes exigir en la entrega. Sin registro y sin dejar tu correo.</p>
        </div>
        <p class="conteo" aria-hidden="true">{String(guias.length).padStart(2, '0')}</p>
      </div>
    </section>

    <section class="lista section-tight">
      <div class="shell">
        <ol class="filas">
          {guias.map((g, i) => (
            <li data-reveal style={`transition-delay: ${i * 0.06}s`}>
              <a href={`/guias/${g.id}/`}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="texto">
                  <span class="h3 titulo">{g.data.title}</span>
                  <span class="resumen muted">{g.data.answer}</span>
                  <span class="meta mono">Actualizada el {g.data.updated} · {g.data.readingMinutes} min de lectura</span>
                </span>
                <span class="leer link" aria-hidden="true">Leer</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .escenario {
    padding-block: clamp(3rem, 6vw, 5rem);
    background:
      radial-gradient(70rem 36rem at 15% -10%, rgb(45 106 245 / .22), transparent 60%),
      var(--stage);
    border-bottom: 1px solid var(--stage-line);
    color: var(--stage-text);
  }
  .grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 3fr); gap: 2rem; align-items: center; }
  .esc-eyebrow {
    color: var(--brand-blue);
    font-family: var(--font-mono);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .copy .display { margin-top: .8rem; color: #fff; max-width: 18ch; }
  .copy .lead { margin-top: 1.1rem; max-width: 56ch; color: var(--stage-muted); }
  .conteo {
    justify-self: end;
    margin: 0;
    font-size: clamp(5rem, 12vw, 10rem);
    font-weight: 680;
    letter-spacing: -.06em;
    line-height: .8;
    color: transparent;
    background: linear-gradient(160deg, rgb(255 255 255 / .2), rgb(45 106 245 / .5));
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* Cada guía es una fila con su número, no un renglón suelto: el número da el
     ancla visual que la lista de antes no tenía. */
  .filas { list-style: none; margin: 0; padding: 0; display: grid; }
  .filas li { border-top: 1px solid var(--line); }
  .filas li:last-child { border-bottom: 1px solid var(--line); }
  .filas a {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease;
  }
  .filas a:hover { background: var(--white); }
  .filas a:hover .titulo { color: var(--blue-dark); }
  .idx {
    color: var(--ordinal);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .texto { display: grid; gap: .6rem; }
  .titulo { display: block; transition: color 140ms ease; }
  .resumen { max-width: 68ch; line-height: 1.6; }
  .meta { color: var(--text-muted); font-size: .78rem; }
  .leer { align-self: center; white-space: nowrap; font-size: .92rem; }

  /* El hover que pinta el fondo no debe cortarse contra el margen del shell. */
  @media (min-width: 901px) {
    .filas a { padding-inline: 1.25rem; margin-inline: -1.25rem; border-radius: var(--radius-sm); }
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .conteo { justify-self: start; }
    .filas a { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding: 1.6rem 0; }
    .idx { font-size: 1.15rem; }
    .leer { display: none; }
  }
</style>
