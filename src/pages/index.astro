---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import LogoRow from '../components/home/LogoRow.astro';
import AgenticLayer from '../components/home/AgenticLayer.astro';
import ProjectsGrid from '../components/home/ProjectsGrid.astro';
import ServicesList from '../components/home/ServicesList.astro';
import ProductsRow from '../components/home/ProductsRow.astro';
import Method from '../components/home/Method.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';

const title = 'ZulIA | Consultoría de software, automatización e IA en Monterrey';
const description =
  'Conectamos el ERP, el CRM, el correo y WhatsApp que tu empresa ya usa a una capa de IA que consulta, ejecuta y pide aprobación cuando toca. Software a medida, sitios, ingeniería con IA y cursos.';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://zulia.lat/#haziel-zul',
  name: SITE.founder,
  jobTitle: SITE.founderRole,
  worksFor: { '@id': 'https://zulia.lat/#organization' },
  url: 'https://zulia.lat/nosotros/',
};
---

<Layout title={title} description={description} jsonLd={[personSchema]}>
  <Navbar />
  <main id="contenido">
    <Hero />
    <LogoRow />
    <AgenticLayer />
    <ProjectsGrid />
    <ServicesList />
    <ProductsRow />
    <Method />
    <CtaBand />
  </main>
  <Footer />
</Layout>
