---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import LogoRow from '../components/home/LogoRow.astro';
import AgenticLayer from '../components/home/AgenticLayer.astro';
import ProjectsGrid from '../components/home/ProjectsGrid.astro';
import ServicesList from '../components/home/ServicesList.astro';
import ForWho from '../components/home/ForWho.astro';
import ProductsRow from '../components/home/ProductsRow.astro';
import Method from '../components/home/Method.astro';
import HowToStart from '../components/home/HowToStart.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';

const title = 'ZulIA | Consultoría de software, automatización e IA en Monterrey';
const description =
  'Consultoría en Monterrey. Construimos plataformas internas, sitios, catálogos y tiendas en línea, y conectamos el ERP, el CRM y WhatsApp a asistentes de IA con permisos.';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://zulia.lat/#haziel-zul',
  name: SITE.founder,
  jobTitle: SITE.founderRole,
  worksFor: { '@id': 'https://zulia.lat/#organization' },
  url: 'https://zulia.lat/nosotros/',
};
---

<Layout title={title} description={description} jsonLd={[personSchema]}>
  <Navbar />
  <main id="contenido">
    <Hero />
    <LogoRow />
    <ServicesList />
    <ForWho />
    <AgenticLayer />
    <ProjectsGrid />
    <Method />
    <HowToStart />
    <ProductsRow />
    <CtaBand />
  </main>
  <Footer />
</Layout>
