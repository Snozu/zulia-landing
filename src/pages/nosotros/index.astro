---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import LogoRow from '../../components/home/LogoRow.astro';
import { SITE } from '../../data/site';
import { faqs } from '../../data/faqs';
import { getProjects } from '../../lib/projects';

const title = 'Consultoría de software e IA en Monterrey: quiénes somos | ZulIA';
const description =
  'ZulIA es una consultoría de software, automatización e inteligencia artificial en Monterrey. Quién construye, con qué experiencia y por qué el código es tuyo.';

// Las cifras salen de los casos publicados, no de una promesa: si el número
// cambia, cambia porque se publicó o se retiró un proyecto.
const projects = await getProjects();
const sectores = new Set(projects.map((p) => p.data.sector)).size;
const cifras = [
  { v: String(projects.length), l: 'proyectos publicados, con cliente y año' },
  { v: String(sectores), l: 'sectores, de acero y fintech a despachos legales' },
  { v: '6+', l: 'años de la dirección técnica construyendo software que opera a diario' },
  { v: '100%', l: 'del código y la infraestructura, a nombre del cliente' },
];

// Lo que se usa de verdad en los proyectos publicados. Es la respuesta corta a
// «¿tiene con qué?», y es verificable: cada pieza aparece en algún caso.
const stack = [
  'LangGraph', 'RAG', 'MCP', 'LLMs', 'Python', 'Node.js', 'NestJS',
  'React', 'Astro', 'PostgreSQL', 'pgvector', 'Redis', 'BullMQ', 'Docker', 'n8n',
];

const principles = [
  { t: 'La IA es una herramienta, no el producto', d: 'Se usa donde aporta. Si un proceso se resuelve con una regla o una integración, eso hacemos.' },
  { t: 'Nada escribe en tus sistemas sin permiso', d: 'Lectura primero. Escritura declarada por herramienta. Dinero y cambios sensibles pasan por una persona.' },
  { t: 'El código y la infraestructura son tuyos', d: 'Repositorios, servidores, dominios y accesos quedan a nombre de tu empresa desde el primer día.' },
  { t: 'Criterio senior de principio a fin', d: 'Estrategia, diseño e ingeniería responden a la misma dirección técnica. Nadie traduce entre quien vende y quien construye.' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://zulia.lat/#haziel-zul',
  name: SITE.founder,
  jobTitle: SITE.founderRole,
  worksFor: { '@id': 'https://zulia.lat/#organization' },
  url: 'https://zulia.lat/nosotros/',
  sameAs: [SITE.founderLinkedin],
  knowsAbout: stack,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={title} description={description} jsonLd={[personSchema, faqSchema]}>
  <Navbar />
  <main id="contenido" class="nosotros">
    <section class="head section-tight">
      <div class="shell">
        <p class="label">Nosotros</p>
        <h1 class="display">Dirigido por quien ya construyó esto antes.</h1>
        <p class="lead">ZulIA es una consultoría de software, automatización e inteligencia artificial en Monterrey. Tu proyecto lo dirige quien ya arquitectó sistemas de este tamaño y sigue metido en el código, no un ejecutivo de cuenta que traduce entre tú y alguien más.</p>
      </div>
    </section>

    {/* La prueba antes que la biografía. Quien llega aquí está midiendo si esto
        aguanta un proyecto serio; las cifras salen de los casos publicados. */}
    <section class="cifras escenario">
      <div class="shell">
        <div class="cif-head" data-reveal>
          <p class="esc-eyebrow">Lo que hay detrás</p>
          <h2 class="h2">Trabajo entregado, no trayectoria contada.</h2>
        </div>
        <ul class="cif-grid">
          {cifras.map((c, i) => (
            <li data-reveal style={`transition-delay: ${i * 0.07}s`}>
              <strong>{c.v}</strong>
              <span>{c.l}</span>
            </li>
          ))}
        </ul>
        <p class="cif-pie" data-reveal>
          Cada proyecto de esta cuenta está publicado con nombre de cliente, ciudad y año.
          <a class="link" href="/proyectos/">Revísalos uno por uno</a>.
        </p>
      </div>
    </section>

    <LogoRow />

    <section class="fundador section">
      <div class="shell fnd-grid">
        <div class="fnd-copy" data-reveal>
          <p class="label">Dirección técnica</p>
          <h2 class="display fnd-nombre">{SITE.founder}</h2>
          <p class="fnd-rol">{SITE.founderRole} · Arquitecto de agentes de IA</p>

          <div class="prose fnd-bio">
            <p>Más de seis años dirigiendo y arquitectando plataformas, automatizaciones y sistemas de inteligencia artificial para logística, automotriz, industria pesada, fintech y producto digital. Entre ellos, sistemas multiagente en producción y asistentes que operan plataformas con miles de usuarios.</p>
            <p>Fundó ZulIA para llevar ese criterio a empresas que no tienen un equipo de producto interno: diagnóstico honesto, fases del tamaño correcto y sistemas que el cliente pueda operar sin quedar atrapado con un proveedor.</p>
            <p>Dirige desde Monterrey y trabaja con equipos en México y en otros países.</p>
          </div>

          <a class="link fnd-li" href={SITE.founderLinkedin} target="_blank" rel="noopener">Ver el perfil en LinkedIn</a>
        </div>

        <div class="fnd-lado" data-reveal style="transition-delay: .08s">
          <p class="label">Con qué se construye</p>
          <ul class="stack">
            {stack.map((t) => <li>{t}</li>)}
          </ul>
          <p class="stack-pie muted">Nada de esto es una lista de currículum: cada pieza está corriendo en alguno de los proyectos publicados.</p>
        </div>
      </div>
    </section>

    <section class="principles section-tight">
      <div class="shell">
        <div class="prin-head">
          <h2 class="h2">En qué creemos</h2>
          <p class="muted">Cuatro reglas que no se negocian, porque son las que hacen que un proyecto se pueda sostener después.</p>
        </div>
        <div class="cols-linea c4 four">
          {principles.map((p, i) => (
            <article data-reveal style={`transition-delay: ${i * 0.06}s`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{p.t}</h3>
              <p class="muted">{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="faq section-tight">
      <div class="shell-narrow">
        <h2 class="h2">Preguntas frecuentes</h2>
        <div class="qa">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .head .display { margin-top: 1rem; max-width: 18ch; }
  .head .lead { margin-top: 1.25rem; max-width: 62ch; }

  /* Misma banda oscura que las páginas de servicio: es la firma visual del
     sitio y aquí carga la prueba, que es lo que se viene a buscar. */
  .escenario {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(80rem 40rem at 20% -10%, rgb(45 106 245 / .22), transparent 60%),
      var(--stage);
    border-block: 1px solid var(--stage-line);
    color: var(--stage-text);
  }
  .esc-eyebrow {
    color: var(--brand-blue);
    font-family: var(--font-mono);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .cif-head .h2 { margin-top: .6rem; color: #fff; max-width: 22ch; }
  .cif-grid {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--stage-line);
  }
  .cif-grid li { display: grid; gap: .5rem; align-content: start; padding: 1.75rem 1.75rem 0 0; }
  .cif-grid li + li { padding-left: 1.75rem; border-left: 1px solid var(--stage-line); }
  .cif-grid strong {
    color: #fff;
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 660;
    letter-spacing: -.04em;
    line-height: 1;
  }
  .cif-grid li:nth-child(2) strong,
  .cif-grid li:last-child strong { color: var(--brand-blue); }
  .cif-grid span { color: var(--stage-muted); font-size: .9rem; line-height: 1.5; }
  .cif-pie { margin-top: 2.25rem; color: var(--stage-muted); font-size: .95rem; line-height: 1.6; }
  .cif-pie .link { color: #fff; }

  /* Fundador: el nombre pesa, no una caja oscura vacía como antes. */
  .fnd-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .fnd-nombre { margin-top: .75rem; font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .fnd-rol { margin-top: .6rem; color: var(--blue-dark); font-size: 1.15rem; font-weight: 550; }
  .fnd-bio { margin-top: 1.75rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .fnd-bio p { color: var(--ink-soft); }
  .fnd-bio p + p { margin-top: 1rem; }
  .fnd-li { display: inline-block; margin-top: 1.5rem; }

  .fnd-lado { position: sticky; top: 6rem; }
  .stack { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .stack li {
    padding: .4rem .75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--ink);
  }
  .stack-pie { margin-top: 1.1rem; font-size: .88rem; line-height: 1.6; }

  .prin-head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3rem; align-items: end; margin-bottom: 2.25rem; }
  .prin-head .h2 { max-width: 14ch; }
  .prin-head p { max-width: 48ch; font-size: 1.02rem; line-height: 1.6; }
  .four article { display: grid; gap: .6rem; align-content: start; }
  .num { color: var(--blue-dark); font-family: var(--font-mono); font-size: .78rem; font-weight: 700; letter-spacing: .06em; }

  .qa { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { padding: 1.1rem 0; cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::after { content: "+"; color: var(--blue-dark); font-weight: 500; }
  details[open] summary::after { content: "−"; }
  details p { padding: 0 0 1.25rem; max-width: 65ch; }

  @media (max-width: 1000px) {
    .cif-grid { grid-template-columns: 1fr 1fr; }
    .cif-grid li:nth-child(3) { padding-left: 0; border-left: 0; }
    .cif-grid li:nth-child(n + 3) { margin-top: 1.75rem; border-top: 1px solid var(--stage-line); }
  }
  @media (max-width: 800px) {
    .fnd-grid { grid-template-columns: 1fr; }
    .fnd-lado { position: static; }
    .prin-head { grid-template-columns: 1fr; gap: .85rem; align-items: start; }
    .prin-head .h2 { max-width: none; }
  }
  @media (max-width: 560px) {
    .cif-grid { grid-template-columns: 1fr; }
    .cif-grid li + li { padding-left: 0; border-left: 0; margin-top: 1.75rem; border-top: 1px solid var(--stage-line); }
  }
</style>
