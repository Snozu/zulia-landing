---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { CTA } from '../data/site';

// Un 404 no es una disculpa: es la última oportunidad de que quien llegó mal
// termine donde quería. Por eso lleva los servicios completos y no una lista
// de enlaces sueltos.
const destinos = [
  { t: 'Proyectos', d: 'Veintiún casos con cliente, ciudad, año y resultado.', href: '/proyectos/' },
  { t: 'Servicios', d: 'Las siete formas de trabajar con nosotros.', href: '/servicios/' },
  { t: 'Semilla', d: 'Prospección B2B operada por agentes.', href: '/semilla/' },
  { t: 'Nosotros', d: 'Quién dirige, con qué experiencia y bajo qué reglas.', href: '/nosotros/' },
];
---

<Layout title="Página no encontrada | ZulIA" description="La página que buscas no existe o cambió de dirección." noindex>
  <Navbar />
  <main id="contenido">
    <section class="cuatro escenario">
      <div class="shell grid">
        <div class="copy">
          <p class="eyebrow">Error 404</p>
          <h1 class="display">Esta página no existe.</h1>
          <p class="lead">O cambió de dirección con el rediseño del sitio. No te quedes aquí: abajo está todo lo que sí existe.</p>
          <div class="ctas">
            <a class="btn" href="/">Ir al inicio</a>
            <a class="link" href={CTA.primaryHref}>Cuéntanos qué buscabas</a>
          </div>
        </div>
        <p class="numerote" aria-hidden="true">404</p>
      </div>
    </section>

    <section class="rutas section-tight">
      <div class="shell">
        <p class="label">Servicios</p>
        <div class="cols-linea c3 srv">
          {services.map((s, i) => (
            <a href={`/servicios/${s.slug}/`} data-reveal style={`transition-delay: ${i * 0.04}s`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="h3">{s.name}</h2>
              <p class="muted">{s.promise}</p>
            </a>
          ))}
        </div>

        <p class="label mas">Lo demás</p>
        <ul class="filas-linea otros">
          {destinos.map((d) => (
            <li>
              <a href={d.href}>
                <span class="otros-t">{d.t}</span>
                <span class="otros-d muted">{d.d}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .escenario {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    background:
      radial-gradient(80rem 40rem at 15% -10%, rgb(45 106 245 / .24), transparent 60%),
      var(--stage);
    border-bottom: 1px solid var(--stage-line);
    color: var(--stage-text);
  }
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2rem; align-items: center; }
  .eyebrow {
    color: var(--brand-blue);
    font-family: var(--font-mono);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .copy .display { margin-top: .8rem; color: #fff; max-width: 14ch; }
  .copy .lead { margin-top: 1.1rem; max-width: 46ch; color: var(--stage-muted); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 1.75rem; }
  .ctas .btn { background: var(--brand-blue); border-color: var(--brand-blue); }
  .ctas .btn:hover { background: #2358e0; border-color: #2358e0; }
  .ctas .link { color: #fff; }

  /* El número es el gráfico de la página. Sin él esto es un mensaje de error
     en una caja oscura y nada más. */
  .numerote {
    justify-self: end;
    margin: 0;
    font-size: clamp(7rem, 18vw, 15rem);
    font-weight: 680;
    letter-spacing: -.06em;
    line-height: .8;
    color: transparent;
    background: linear-gradient(160deg, rgb(255 255 255 / .22), rgb(45 106 245 / .55));
    -webkit-background-clip: text;
    background-clip: text;
  }

  .srv { margin-top: 1.5rem; }
  .srv a { display: grid; gap: .5rem; align-content: start; color: inherit; text-decoration: none; }
  .srv a:hover .h3 { color: var(--blue-dark); }
  .num { color: var(--blue-dark); font-family: var(--font-mono); font-size: .78rem; font-weight: 700; letter-spacing: .06em; }

  .mas { margin-top: 3rem; }
  .otros { margin-top: 1rem; }
  .otros a { display: flex; align-items: baseline; gap: 1rem; color: inherit; text-decoration: none; }
  .otros-t { min-width: 9rem; font-weight: 620; }
  .otros-d { font-size: .95rem; }
  .otros a:hover .otros-t { color: var(--blue-dark); }

  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .numerote { justify-self: start; }
    .otros a { flex-direction: column; gap: .2rem; }
    .otros-t { min-width: 0; }
  }
</style>
