---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { NAV } from '../data/site';
---

<Layout title="Página no encontrada | ZulIA" description="La página que buscas no existe o cambió de dirección." noindex>
  <Navbar />
  <main id="contenido">
    <section class="section">
      <div class="shell-narrow">
        <p class="label">Error 404</p>
        <h1 class="display">Esta página no existe.</h1>
        <p class="lead">Puede que el enlace haya cambiado con el rediseño del sitio. Estas son las secciones principales:</p>
        <ul class="list">
          <li><a href="/">Inicio</a></li>
          {NAV.map((n) => (<li><a href={n.href}>{n.label}</a></li>))}
          <li><a href="/cotizar/">Cotizar</a></li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .display { margin-top: 1rem; }
  .lead { margin-top: 1.25rem; }
  .list { margin: 2rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .list li { border-bottom: 1px solid var(--line); }
  .list a { display: block; padding: .9rem 0; color: var(--ink); font-weight: 500; text-decoration: none; }
  .list a:hover { color: var(--blue-dark); }
</style>
