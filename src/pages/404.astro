---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { services } from '../data/services';

const title = 'Página no encontrada | ZulIA';
const description = 'La ruta que buscas no existe o cambió de lugar. Estas son las secciones que sí están activas en ZulIA.';
---

<Layout title={title} description={description} noindex>
  <Navbar />

  <main id="contenido" class="notfound">
    <div class="notfound-mark" aria-hidden="true">404</div>

    <div class="page-shell notfound-shell">
      <div class="notfound-copy" data-reveal>
        <p class="eyebrow"><span></span> Error 404 · Ruta sin destino</p>
        <h1>Esta página no existe. <em>El resto sí funciona.</em></h1>
        <p class="notfound-lead">
          El enlace que seguiste está roto, cambió de lugar o nunca existió. No te dejamos aquí:
          abajo están las rutas que sí llevan a algún lado.
        </p>
        <div class="notfound-actions">
          <a class="button-primary" href="/">Volver al inicio</a>
          <a class="button-secondary" href="/#contacto">Hablemos</a>
        </div>
      </div>

      <nav class="notfound-routes" aria-labelledby="routes-title" data-reveal>
        <p class="routes-title" id="routes-title">A dónde sí puedes ir</p>

        <a class="route route-feature" href="/semilla/">
          <span class="route-number">00</span>
          <span class="route-body">
            <strong>Semilla</strong>
            <small>Prospección agéntica B2B que trabaja todos los días.</small>
          </span>
          <i aria-hidden="true"></i>
        </a>

        {services.map((service) => (
          <a class="route" href={`/servicios/${service.slug}/`}>
            <span class="route-number">{service.number}</span>
            <span class="route-body">
              <strong>{service.shortName}</strong>
              <small>{service.idealFor}</small>
            </span>
            <i aria-hidden="true"></i>
          </a>
        ))}
      </nav>
    </div>
  </main>
</Layout>

<style>
  .notfound {
    position: relative;
    isolation: isolate;
    display: flex;
    /* Descuenta el header para llenar exactamente la pantalla: así la cifra de
       fondo se recorta contra el borde inferior y no a media altura. */
    min-height: calc(100svh - 5.4rem);
    align-items: center;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    background: var(--paper);
    color: var(--ink);
  }

  /* Mismo recurso editorial que la sección Cosecha: una cifra enorme que vive
     detrás del contenido. Se ancla al borde inferior y se recorta ahí a
     propósito, para que el corte se lea como decisión y no como accidente. */
  .notfound-mark {
    position: absolute;
    z-index: -1;
    bottom: -.3em;
    left: 50%;
    color: color-mix(in srgb, var(--ink) 5.5%, transparent);
    font-size: clamp(9rem, 30vw, 26rem);
    font-weight: 760;
    letter-spacing: -.075em;
    line-height: .75;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .notfound-shell {
    display: grid;
    grid-template-columns: 1.05fr .82fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .notfound h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.6rem, 5.6vw, 5.2rem);
    font-weight: 620;
    letter-spacing: -.065em;
    line-height: .95;
  }

  .notfound h1 em {
    display: block;
    color: var(--blue-dark);
    font-style: normal;
  }

  .notfound-lead {
    max-width: 34rem;
    margin: 1.6rem 0 0;
    color: var(--text-muted);
    font-size: .95rem;
    line-height: 1.75;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    margin-top: 2.2rem;
  }

  .notfound-routes {
    padding: clamp(1.2rem, 2.6vw, 1.7rem);
    border: 1px solid var(--line);
    border-radius: 1.8rem 1.8rem 3.2rem 1.8rem;
    background: var(--glass-strong);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(24px) saturate(140%);
  }

  .routes-title {
    margin: 0 0 .9rem;
    padding-inline: .55rem;
    color: var(--ink-soft);
    font-size: .64rem;
    font-weight: 750;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .route {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: .95rem;
    padding: .78rem .55rem;
    border-radius: 1.1rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .route + .route { border-top: 1px solid var(--line); }
  .route:hover { background: color-mix(in srgb, var(--blue) 9%, transparent); transform: translateX(3px); }
  .route:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

  .route-number {
    color: var(--blue-dark);
    font-size: .62rem;
    font-weight: 760;
    font-variant-numeric: tabular-nums;
    letter-spacing: .04em;
  }

  .route-body { display: grid; gap: .16rem; min-width: 0; }
  .route-body strong { font-size: .89rem; font-weight: 660; letter-spacing: -.02em; }

  .route-body small {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: .72rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .route i {
    width: 1rem;
    height: 1px;
    background: var(--line-dark);
    transform-origin: right;
    transition: transform 240ms cubic-bezier(.2,.8,.2,1), background-color 180ms ease;
  }

  .route:hover i { background: var(--blue-dark); transform: scaleX(1.6); }

  .route-feature { background: color-mix(in srgb, var(--blue) 7%, transparent); }
  .route-feature .route-body strong { color: var(--blue-dark); }

  @media (max-width: 900px) {
    .notfound-shell { grid-template-columns: 1fr; gap: 2.8rem; }
    .notfound { min-height: auto; }
    .notfound h1 { max-width: 16ch; }
  }

  @media (max-width: 560px) {
    .notfound-mark { font-size: clamp(9rem, 46vw, 14rem); }
    .notfound-actions > * { flex: 1; }
    .notfound-routes { border-radius: 1.5rem 1.5rem 2.6rem 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .route, .route i { transition: none; }
    .route:hover { transform: none; }
  }

  @media (prefers-reduced-transparency: reduce) {
    .notfound-routes { background: var(--white); backdrop-filter: none; }
  }
</style>
