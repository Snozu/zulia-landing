---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
const count = (line: string) => projects.filter((p) => p.data.line === line).length;
const title = 'Servicios | ZulIA';
const description =
  'Capa agéntica sobre tus sistemas, software operativo a medida, sitios y catálogos, ingeniería asistida por IA para equipos y capacitación. Consultoría en Monterrey.';
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="contenido">
    <section class="head section-tight">
      <div class="shell">
        <p class="label">Servicios</p>
        <h1 class="display">Seis formas de trabajar con nosotros.</h1>
        <p class="lead">Todas parten de la misma idea: menos pantallas, más resultado. La capa agéntica es la especialidad; lo demás la hace posible, la extiende o la pone a vender.</p>
      </div>
    </section>

    <section class="list" aria-label="Servicios">
      <div class="shell">
        <ol class="rows">
          {services.map((s) => (
            <li>
              <a class="row" href={`/servicios/${s.slug}/`}>
                <div class="left">
                  <span class="mono">{s.shortName}</span>
                  <h2 class="h2">{s.name}</h2>
                  <p class="promise">{s.promise}</p>
                </div>
                <div class="right">
                  <p class="muted">{s.summary}</p>
                  <div class="foot">
                    <span class="mono">{count(s.line)} {count(s.line) === 1 ? 'proyecto' : 'proyectos'}</span>
                    <span class="link">Ver servicio
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .head .display { margin-top: 1rem; max-width: 20ch; }
  .head .lead { margin-top: 1.25rem; }
  .list { padding-bottom: var(--section); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .row:hover .h2 { color: var(--blue-dark); }
  .left { display: grid; gap: .9rem; align-content: start; }
  .left .h2 { max-width: 16ch; transition: color 140ms ease; }
  .promise { font-size: 1.05rem; line-height: 1.45; }
  .right { display: grid; gap: 1.25rem; align-content: space-between; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr; gap: 1.25rem; } }
</style>
