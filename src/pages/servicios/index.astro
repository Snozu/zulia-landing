---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
import { getProjects } from '../../lib/projects';
import { CTA } from '../../data/site';

const projects = await getProjects();
const count = (line: string) => projects.filter((p) => p.data.line === line).length;
const title = 'Servicios de desarrollo de software, IA y automatización | ZulIA';
const description =
  'Capa agéntica sobre tus sistemas, software operativo a medida, sitios y catálogos, ingeniería asistida por IA para equipos y capacitación. Consultoría en Monterrey.';
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="contenido">
    <section class="head section-tight">
      <div class="shell">
        <p class="label">Servicios</p>
        <h1 class="display">Siete formas de trabajar con nosotros.</h1>
        <p class="lead">Todas parten de la misma idea: menos pantallas, más resultado. La capa agéntica es la especialidad; lo demás la hace posible, la extiende o la pone a vender.</p>
      </div>
    </section>

    <section class="list" aria-label="Servicios">
      <div class="shell">
        <div class="grid">
          {services.map((s, i) => (
            <article class={`svc card${i === 0 ? ' feature' : ''}`}>
              <a class="hit" href={`/servicios/${s.slug}/`}><span class="sr-only">{s.name}</span></a>

              <div class="visual">
                {s.visual.type === 'image' && (
                  <figure class="shot">
                    <div class="chrome"><i></i><i></i><i></i></div>
                    <img src={s.visual.src} alt={s.visual.alt} width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  </figure>
                )}
                {s.visual.type === 'stats' && (
                  <div class="stats stage">
                    <ul>
                      {s.visual.items.map((it) => (<li><strong>{it.v}</strong><span>{it.l}</span></li>))}
                    </ul>
                  </div>
                )}
                {s.visual.type === 'list' && (
                  <div class="points">
                    <ol>
                      {s.visual.items.slice(0, 4).map((it) => <li>{it}</li>)}
                    </ol>
                  </div>
                )}
              </div>

              <div class="body">
                <div class="tags">
                  <span class="badge badge-soft">{s.shortName}</span>
                  {i === 0 && <span class="badge">Nuestra especialidad</span>}
                </div>
                <h2 class={i === 0 ? 'h2' : 'h3'}>{s.name}</h2>
                <p class="promise">{s.promise}</p>
                <p class="muted sum">{s.summary}</p>
                <div class="foot">
                  <span class="mono">
                    {count(s.line) > 0
                      ? `${count(s.line)} ${count(s.line) === 1 ? 'proyecto publicado' : 'proyectos publicados'}`
                      : (s.indexNote ?? 'Cotización a medida')}
                  </span>
                  <span class="go">Ver servicio</span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <p class="tail">
          ¿No sabes cuál corresponde a tu caso? <a class="link" href={CTA.primaryHref}>Cuéntanos el problema y te lo decimos</a>.
        </p>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .head .display { margin-top: 1rem; max-width: 20ch; }
  .head .lead { margin-top: 1.25rem; }
  .list { padding-bottom: var(--section); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }

  .svc {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  .svc:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .hit { position: absolute; inset: 0; z-index: 1; }
  .hit:focus-visible { outline: 2px solid var(--accent-surface); outline-offset: -4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* The flagship line gets the wide slot and the copy beside the screenshot. */
  .feature { grid-column: 1 / -1; grid-template-rows: none; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .feature .visual { order: 2; aspect-ratio: auto; min-height: 24rem; border-bottom: 0; border-left: 1px solid var(--line); }
  .feature .body { padding: clamp(1.75rem, 3vw, 2.75rem); align-content: center; }
  .feature .sum { display: block; }

  .visual {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: linear-gradient(160deg, var(--paper-deep), var(--paper));
    border-bottom: 1px solid var(--line);
  }
  .shot { position: absolute; inset: 0; margin: 1.25rem 1.25rem 0; display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--line); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0; overflow: hidden; background: var(--white); box-shadow: var(--shadow-md); }
  .chrome { display: flex; gap: .35rem; align-items: center; height: 1.6rem; padding: 0 .6rem; border-bottom: 1px solid var(--line); background: var(--paper-deep); }
  .chrome i { width: .45rem; height: .45rem; border-radius: 50%; background: var(--line-dark); }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 400ms ease; }
  .svc:hover .shot img { transform: scale(1.02); }

  .stats { position: absolute; inset: 1.25rem; border-radius: var(--radius); display: grid; align-content: center; padding: 1.25rem; }
  .stats ul { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; margin: 0; padding: 0; list-style: none; }
  .stats li { display: grid; gap: .2rem; }
  .stats strong { font-size: clamp(1.3rem, 2.4vw, 1.75rem); font-weight: 650; letter-spacing: -.03em; line-height: 1; color: #fff; }
  .stats li:last-child strong { color: var(--brand-blue); }
  .stats span { color: var(--stage-muted); font-size: .74rem; line-height: 1.35; }

  .points { position: absolute; inset: 1.25rem; display: grid; align-content: center; gap: .5rem; padding: 1.4rem; border-radius: var(--radius); background: var(--blue-soft); }
  .points ol { margin: 0; padding: 0; list-style: none; counter-reset: n; display: grid; gap: .55rem; }
  .points li { counter-increment: n; display: grid; grid-template-columns: 1.4rem 1fr; gap: .6rem; align-items: baseline; color: var(--blue-dark); font-size: .88rem; font-weight: 550; line-height: 1.4; }
  .points li::before { content: counter(n, decimal-leading-zero); font-family: var(--font-mono); font-size: .7rem; opacity: .65; }

  .body { display: grid; gap: .7rem; align-content: start; padding: 1.5rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .promise { font-size: 1.02rem; font-weight: 550; line-height: 1.45; color: var(--ink); }
  .sum { display: none; font-size: .92rem; line-height: 1.55; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: .5rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .go { color: var(--blue-dark); font-size: .92rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .32em; text-decoration-color: color-mix(in srgb, currentColor 28%, transparent); transition: text-decoration-color 160ms ease; }
  .svc:hover .go { text-decoration-color: currentColor; }

  .tail { margin-top: 2rem; color: var(--text-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .feature { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .feature .visual { order: 0; aspect-ratio: 16 / 10; min-height: 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .feature .sum { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .svc, .shot img { transition: none; } .svc:hover { transform: none; } }
</style>
