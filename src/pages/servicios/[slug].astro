---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { services, type Service } from '../../data/services';
import { getProjectsByLine } from '../../lib/projects';
import { CTA } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const projects = (await getProjectsByLine(service.line)).slice(0, 4);
const others = services.filter((s) => s.slug !== service.slug);
const quoteHref = `${CTA.primaryHref}?linea=${service.slug}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  provider: { '@id': 'https://zulia.lat/#organization' },
  areaServed: { '@type': 'Country', name: 'México' },
  url: `https://zulia.lat/servicios/${service.slug}/`,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={service.searchTitle} description={service.metaDescription} jsonLd={[serviceSchema, faqSchema]}>
  <Navbar />
  <main id="contenido" class="service">
    <section class="hero">
      <div class="shell grid">
        <div class="copy">
          <nav class="crumbs" aria-label="Ruta"><a href="/servicios/">Servicios</a><span>/</span><span>{service.shortName}</span></nav>
          <h1 class="display">{service.name}</h1>
          <p class="promise">{service.promise}</p>
          <p class="lead">{service.summary}</p>
          <div class="ctas">
            <a class="btn" href={quoteHref}>{CTA.primary}</a>
            <a class="link" href="#empezar">Ver por dónde empezar
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
            </a>
          </div>
        </div>

        <div class="visual">
          {service.visual.type === 'image' && (
            <figure class="card shot">
              <div class="chrome"><i></i><i></i><i></i></div>
              <img src={service.visual.src} alt={service.visual.alt} width="1600" height="1000" loading="eager" decoding="async" />
              <figcaption>{service.visual.caption}</figcaption>
            </figure>
          )}
          {service.visual.type === 'stats' && (
            <div class="stage stats">
              <ul>
                {service.visual.items.map((it) => (<li><strong>{it.v}</strong><span>{it.l}</span></li>))}
              </ul>
              <p>{service.visual.caption}</p>
            </div>
          )}
          {service.visual.type === 'list' && (
            <div class="stage listing">
              <p class="cap">{service.visual.caption}</p>
              <ol>
                {service.visual.items.map((it) => <li>{it}</li>)}
              </ol>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="outcomes section">
      <div class="shell">
        <h2 class="h2">Qué cambia en tu operación</h2>
        <div class="three">
          {service.outcomes.map((o, i) => (
            <article class="card cell">
              <span class="num">{i + 1}</span>
              <h3 class="h3">{o.t}</h3>
              <p class="muted">{o.d}</p>
            </article>
          ))}
        </div>
        <p class="ideal"><strong>Para quién es.</strong> {service.idealFor}</p>
      </div>
    </section>

    <section class="how section-tight">
      <div class="shell cols">
        <div class="side">
          <h2 class="h2">Cómo trabajamos</h2>
          <p class="muted">Por fases cortas, con algo usable al final de cada una. Sin meses de silencio.</p>
        </div>
        <ol class="steps">
          {service.process.map((p, i) => (
            <li class="card">
              <span class="num">{i + 1}</span>
              <div>
                <h3 class="h3">{p.step}</h3>
                <p class="muted">{p.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="deliver section-tight">
      <div class="shell cols">
        <div class="side">
          <h2 class="h2">Qué entregamos</h2>
          <p class="muted">Todo queda a tu nombre: código, cuentas, dominios y accesos.</p>
        </div>
        <ul class="checks">
          {service.deliverables.map((d) => (
            <li>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 10.5 4 4 8-9"/></svg>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="proof section" id="proyectos">
        <div class="shell">
          <div class="head">
            <h2 class="h2">Hecho, no prometido</h2>
            <a class="link" href={`/proyectos/#${service.line}`}>Todos los proyectos de esta línea
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
            </a>
          </div>
          <div class="card-grid grid">
            {projects.map((p) => <ProjectTile project={p} />)}
          </div>
        </div>
      </section>
    )}

    <section class="offer section" id="empezar">
      <div class="shell">
        <div class="offer-card stage">
          <div class="offer-copy">
            <p class="cap">Por dónde empezar</p>
            <h2 class="h2">{service.offer.name}</h2>
            <p class="dur">{service.offer.duration}</p>
            <p class="result">{service.offer.result}</p>
            <div class="ctas">
              <a class="btn" href={quoteHref}>Cotizar esta fase</a>
            </div>
          </div>
          <ul class="offer-list">
            {service.offer.includes.map((it) => (
              <li>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 10.5 4 4 8-9"/></svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {service.faq.length > 0 && (
      <section class="faq section-tight">
        <div class="shell-narrow">
          <h2 class="h2">Preguntas frecuentes</h2>
          <div class="qa">
            {service.faq.map((f) => (
              <details class="card">
                <summary>{f.q}</summary>
                <p class="muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="others section-tight">
      <div class="shell">
        <p class="label">Otros servicios</p>
        <ul class="other-list">
          {others.map((o) => (<li><a href={`/servicios/${o.slug}/`}>{o.name}</a></li>))}
        </ul>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .hero { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .crumbs { display: flex; gap: .6rem; color: var(--text-muted); font-size: .85rem; }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .copy { display: grid; gap: 1.1rem; }
  .copy .display { max-width: 16ch; margin-top: .5rem; }
  .promise { font-size: 1.25rem; font-weight: 550; line-height: 1.4; max-width: 34ch; color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: .5rem; }

  .shot { margin: 0; overflow: hidden; }
  .chrome { display: flex; gap: .4rem; height: 1.9rem; align-items: center; padding: 0 .75rem; border-bottom: 1px solid var(--line); background: var(--paper-deep); }
  .chrome i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--line-dark); }
  .shot img { display: block; width: 100%; height: auto; }
  .shot figcaption { padding: .8rem 1rem; border-top: 1px solid var(--line); color: var(--text-muted); font-size: .82rem; }
  .stats { display: grid; gap: 1.25rem; padding: 1.75rem; }
  .stats ul { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .stats li { display: grid; gap: .25rem; padding: 1rem 1.1rem; border: 1px solid var(--stage-line); border-radius: var(--radius-sm); background: rgb(255 255 255 / .04); }
  .stats strong { font-size: 1.9rem; font-weight: 650; letter-spacing: -.03em; line-height: 1; color: #fff; }
  .stats li:last-child strong { color: var(--brand-blue); }
  .stats span { color: var(--stage-muted); font-size: .82rem; }
  .stats p { color: var(--stage-muted); font-size: .8rem; line-height: 1.5; }
  .listing { display: grid; gap: 1rem; padding: 1.75rem; }
  .cap { color: var(--stage-muted); font-size: .8rem; }
  .listing ol { margin: 0; padding: 0; list-style: none; counter-reset: n; display: grid; }
  .listing li { counter-increment: n; display: grid; grid-template-columns: 2rem 1fr; gap: .75rem; padding: .8rem 0; border-top: 1px solid var(--stage-line); color: #fff; }
  .listing li::before { content: counter(n, decimal-leading-zero); font-family: var(--font-mono); font-size: .75rem; color: var(--brand-blue); padding-top: .2rem; }

  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
  .cell { display: grid; gap: .75rem; align-content: start; padding: 1.75rem; }
  .num { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--blue-soft); color: var(--blue-dark); font-weight: 650; font-size: .9rem; }
  .ideal { margin-top: 1.5rem; max-width: 70ch; color: var(--text-muted); }
  .ideal strong { color: var(--ink); }

  .cols { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 3rem; align-items: start; }
  .side { display: grid; gap: .75rem; position: sticky; top: calc(var(--nav-h) + 2rem); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; align-items: start; padding: 1.25rem 1.5rem; }
  .steps p { margin-top: .3rem; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .checks li { display: grid; grid-template-columns: 1.4rem 1fr; gap: .6rem; align-items: start; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--white); box-shadow: var(--shadow-sm); line-height: 1.45; }
  .checks svg { width: 1.2rem; height: 1.2rem; color: var(--blue-dark); margin-top: .1rem; }

  .proof .head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .proof .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .offer-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; padding: clamp(2rem, 4vw, 3rem); }
  .offer-copy { display: grid; gap: .9rem; align-content: start; }
  .offer-copy .h2 { color: #fff; }
  .dur { color: var(--brand-blue); font-weight: 650; }
  .result { color: var(--stage-muted); line-height: 1.55; }
  .offer .btn { background: var(--brand-blue); border-color: var(--brand-blue); }
  .offer .btn:hover { background: #2358e0; border-color: #2358e0; }
  .offer-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; align-content: start; }
  .offer-list li { display: grid; grid-template-columns: 1.3rem 1fr; gap: .6rem; padding: .85rem 1rem; border: 1px solid var(--stage-line); border-radius: var(--radius-sm); background: rgb(255 255 255 / .04); color: #f2f3f5; line-height: 1.45; }
  .offer-list svg { width: 1.15rem; height: 1.15rem; color: var(--brand-blue); margin-top: .1rem; }

  .qa { margin-top: 1.5rem; display: grid; gap: .75rem; }
  details { padding: 0 1.25rem; }
  summary { padding: 1rem 0; cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::after { content: "+"; color: var(--blue-dark); font-weight: 500; }
  details[open] summary::after { content: "−"; }
  details p { padding: 0 0 1.1rem; max-width: 65ch; }
  .other-list { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; }
  .other-list a { display: inline-block; padding: .55rem .9rem; border: 1px solid var(--line); border-radius: 999px; background: var(--white); box-shadow: var(--shadow-sm); color: var(--ink); font-size: .9rem; text-decoration: none; }
  .other-list a:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  @media (max-width: 1000px) { .three { grid-template-columns: 1fr; } }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .cols { grid-template-columns: 1fr; gap: 1.5rem; }
    .side { position: static; }
    .checks { grid-template-columns: 1fr; }
    .proof .grid { grid-template-columns: 1fr; }
    .offer-card { grid-template-columns: 1fr; }
  }
</style>
