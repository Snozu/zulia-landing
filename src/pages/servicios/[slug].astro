---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { services, type Service } from '../../data/services';
import { getProjectsByLine } from '../../lib/projects';
import { CTA } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const projects = (await getProjectsByLine(service.line)).slice(0, 4);
const others = services.filter((s) => s.slug !== service.slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  provider: { '@id': 'https://zulia.lat/#organization' },
  areaServed: { '@type': 'Country', name: 'México' },
  url: `https://zulia.lat/servicios/${service.slug}/`,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={service.searchTitle} description={service.metaDescription} jsonLd={[serviceSchema, faqSchema]}>
  <Navbar />
  <main id="contenido">
    <section class="head section-tight">
      <div class="shell">
        <nav class="crumbs mono" aria-label="Ruta"><a href="/servicios/">Servicios</a> <span>/</span> <span>{service.shortName}</span></nav>
        <h1 class="display">{service.name}</h1>
        <p class="lead promise">{service.promise}</p>
        <div class="ctas">
          <a class="btn" href={CTA.primaryHref}>{CTA.primary}</a>
          <a class="link" href="#proyectos">Ver proyectos de esta línea
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="what section">
      <div class="shell cols">
        <div>
          <h2 class="h2">Qué es</h2>
          <p class="prose big">{service.summary}</p>
          <h3 class="h3 mt">Para quién</h3>
          <p class="prose muted">{service.idealFor}</p>
        </div>
        <div>
          <p class="label">Qué entregamos</p>
          <ul class="deliverables">
            {service.deliverables.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="process section-tight">
      <div class="shell">
        <p class="label">Cómo trabajamos</p>
        <ol class="steps">
          {service.process.map((p, i) => (
            <li>
              <span class="mono">Paso {i + 1}</span>
              <h3 class="h3">{p.step}</h3>
              <p class="muted">{p.detail}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="projects section" id="proyectos">
        <div class="shell">
          <h2 class="h2">Proyectos de {service.shortName.toLowerCase()}</h2>
          <div class="hairline-grid grid">
            {projects.map((p) => <ProjectTile project={p} />)}
          </div>
          <a class="link more" href={`/proyectos/#${service.line}`}>Todos los proyectos de esta línea
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
          </a>
        </div>
      </section>
    )}

    {service.faq.length > 0 && (
      <section class="faq section-tight">
        <div class="shell-narrow">
          <h2 class="h2">Preguntas frecuentes</h2>
          <div class="qa">
            {service.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p class="muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="others section-tight">
      <div class="shell">
        <p class="label">Otros servicios</p>
        <ul class="other-list">
          {others.map((o) => (<li><a href={`/servicios/${o.slug}/`}>{o.name}</a></li>))}
        </ul>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .crumbs { display: flex; gap: .6rem; }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .head .display { margin-top: 1.25rem; max-width: 18ch; }
  .promise { margin-top: 1.25rem; color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .cols { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
  .big { margin-top: 1rem; font-size: 1.125rem; line-height: 1.55; }
  .mt { margin-top: 2rem; }
  .cols .prose.muted { margin-top: .75rem; }
  .deliverables { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: .6rem; }
  .deliverables li { padding: .9rem 1.1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--white); line-height: 1.5; }
  .steps { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .steps li { display: grid; gap: .6rem; align-content: start; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); box-shadow: var(--shadow-sm); }
  .projects .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.5rem; }
  .more { margin-top: 1.5rem; }
  .qa { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { padding: 1.1rem 0; cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::after { content: "+"; color: var(--blue-dark); font-weight: 500; }
  details[open] summary::after { content: "−"; }
  details p { padding: 0 0 1.25rem; max-width: 65ch; }
  .other-list { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; }
  .other-list a { display: inline-block; padding: .55rem .9rem; border: 1px solid var(--line); border-radius: 999px; background: var(--white); box-shadow: var(--shadow-sm); color: var(--ink); font-size: .9rem; text-decoration: none; }
  .other-list a:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; gap: 2.5rem; }
    .steps { grid-template-columns: 1fr 1fr; }
    .projects .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
