---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactSection from '../../components/ContactSection.astro';
import AutomationFlow from '../../components/AutomationFlow.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import SearchVisibility from '../../components/SearchVisibility.astro';
import { services, type Service } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service; }

type Narrative = {
  label: string;
  descriptor: string;
  cta: string;
  contactTitle: string;
  interest: string;
  question: string;
  before: string;
  after: string;
  momentTitle: string;
  scopeTitle: string;
  processTitle: string;
  evidenceTitle: string;
  evidence: Array<{ name: string; context: string }>;
};

const narratives: Record<string, Narrative> = {
  'desarrollo-software-a-medida': {
    label: 'Producto y software',
    descriptor: 'Desarrollo de software a medida',
    cta: 'Revisar mi operación',
    contactTitle: '¿Qué parte de tu operación ya pide un sistema propio?',
    interest: 'Construir software a medida',
    question: '¿Tu equipo trabaja alrededor del sistema, en lugar de que el sistema trabaje para ellos?',
    before: 'Procesos repartidos entre hojas, mensajes y herramientas que no encajan.',
    after: 'Un producto propio que concentra la operación y puede evolucionar con el negocio.',
    momentTitle: 'Cuando la operación ya no cabe en herramientas genéricas.',
    scopeTitle: 'El sistema se diseña alrededor del trabajo real.',
    processTitle: 'Del proceso confuso a un producto que el equipo adopta.',
    evidenceTitle: 'Experiencia construyendo la operación completa',
    evidence: [
      { name: 'SaaS y portales', context: 'Productos multiempresa, backoffices y experiencias para clientes.' },
      { name: 'Operación conectada', context: 'APIs, datos, permisos, pagos, mensajería e infraestructura.' },
      { name: 'Entrega end-to-end', context: 'Producto, UX, frontend, backend, despliegue y medición.' },
    ],
  },
  'agentes-inteligencia-artificial': {
    label: 'Sistemas con inteligencia',
    descriptor: 'Agentes de inteligencia artificial',
    cta: 'Evaluar un caso de IA',
    contactTitle: '¿Qué decisión o tarea quieres delegar con seguridad?',
    interest: 'Implementar agentes de IA',
    question: '¿Tienes información de sobra, pero encontrar contexto y convertirlo en una acción sigue siendo lento?',
    before: 'Chats que responden preguntas aisladas y equipos que todavía ejecutan todo manualmente.',
    after: 'Agentes conectados al conocimiento y las herramientas reales, con límites verificables.',
    momentTitle: 'Cuando responder ya no basta: el sistema también debe decidir o actuar.',
    scopeTitle: 'La inteligencia se conecta con contexto, herramientas y límites.',
    processTitle: 'Primero una tarea valiosa. Después ampliamos con evidencia.',
    evidenceTitle: 'Inteligencia que ya está trabajando',
    evidence: [
      { name: 'Envia Copilot', context: 'Sistema multiagente conectado a decenas de acciones logísticas.' },
      { name: 'Enzo', context: 'Asistente conversacional que cotiza, rastrea y gestiona envíos.' },
      { name: 'MontIA', context: 'Memoria, señales y acciones aprobadas para dirección.' },
    ],
  },
  'automatizacion-procesos': {
    label: 'Automatización operativa',
    descriptor: 'Automatización de procesos',
    cta: 'Mapear un flujo',
    contactTitle: '¿Qué flujo sigue dependiendo de copiar, avisar y perseguir?',
    interest: 'Automatizar una operación',
    question: '¿Tu operación todavía depende de copiar, avisar, perseguir y recordar cada paso?',
    before: 'Información duplicada, pendientes invisibles y procesos que sólo conoce una persona.',
    after: 'Flujos observables que conectan sistemas, mueven datos y escalan las excepciones correctas.',
    momentTitle: 'Cuando el costo no está en una tarea, sino en repetirla cientos de veces.',
    scopeTitle: 'Automatizamos el recorrido completo, incluidas sus excepciones.',
    processTitle: 'Hacemos visible el flujo antes de volverlo automático.',
    evidenceTitle: 'Automatización preparada para producción',
    evidence: [
      { name: 'Flujos n8n', context: 'Webhooks, condiciones, reintentos, alertas y trazabilidad.' },
      { name: 'CRM + WhatsApp', context: 'Prospectos, seguimiento y comunicación sin captura duplicada.' },
      { name: 'APIs y sistemas internos', context: 'Integraciones adaptadas a reglas reales del negocio.' },
    ],
  },
  'landing-pages-seo': {
    label: 'Web, SEO y descubrimiento',
    descriptor: 'Sitios para búsqueda clásica, generativa y agéntica',
    cta: 'Auditar mi visibilidad',
    contactTitle: '¿Dónde debería encontrarte un cliente —o su agente—?',
    interest: 'Mejorar web, e-commerce o growth',
    question: '¿Tu sitio puede ser encontrado, entendido y citado cuando la búsqueda ya no termina en diez enlaces?',
    before: 'Un sitio que sólo funciona para quien ya conoce la marca y busca su nombre exacto.',
    after: 'Una fuente clara, verificable y accionable para clientes, buscadores y sistemas de inteligencia artificial.',
    momentTitle: 'Cuando el mercado no logra encontrarte, entenderte o distinguirte.',
    scopeTitle: 'Cada página debe responder una intención y mover una decisión.',
    processTitle: 'Publicar es el inicio; medir y aprender construye la ventaja.',
    evidenceTitle: 'Una base diseñada para seguir siendo relevante',
    evidence: [
      { name: '15+ sitios en producción', context: 'Landings, e-commerce, corporativos y portales.' },
      { name: 'SEO desde la arquitectura', context: 'Indexación, contenido, rendimiento, entidades y datos estructurados.' },
      { name: 'Visibilidad medible', context: 'Search Console, Bing Webmaster, referencias disponibles y conversión comercial.' },
    ],
  },
  'consultoria-arquitectura-tecnologica': {
    label: 'Estrategia y arquitectura',
    descriptor: 'Consultoría y arquitectura tecnológica',
    cta: 'Aterrizar la decisión',
    contactTitle: '¿Qué decisión técnica necesitas aterrizar?',
    interest: 'Definir un producto o sistema',
    question: '¿Estás por invertir sin saber todavía si conviene construir, comprar, integrar o automatizar?',
    before: 'Una oportunidad importante rodeada de supuestos, dependencias y decisiones técnicas difusas.',
    after: 'Una ruta ejecutable con prioridades, arquitectura, riesgos y un siguiente paso defendible.',
    momentTitle: 'Cuando una mala decisión técnica cuesta más que detenerse a pensar.',
    scopeTitle: 'Convertimos incertidumbre en alternativas que se pueden comparar.',
    processTitle: 'De la pregunta abierta a una ruta que el equipo puede ejecutar.',
    evidenceTitle: 'Criterio que conecta negocio e implementación',
    evidence: [
      { name: 'Diagnóstico', context: 'Procesos, datos, usuarios, costos y restricciones reales.' },
      { name: 'Arquitectura', context: 'Alternativas, integraciones, seguridad y evolución del sistema.' },
      { name: 'Dirección', context: 'Roadmap, entregables y acompañamiento durante la construcción.' },
    ],
  },
};

const { service } = Astro.props;
const narrative = narratives[service.slug];
const canonical = `/servicios/${service.slug}/`;
const related = services.filter((item) => item.slug !== service.slug).slice(0, 3);
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  url: `https://zulia.lat${canonical}`,
  provider: { '@id': 'https://zulia.lat/#organization' },
  areaServed: { '@type': 'Country', name: 'México' },
  serviceType: service.shortName,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://zulia.lat/' },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://zulia.lat/#servicios' },
    { '@type': 'ListItem', position: 3, name: service.shortName, item: `https://zulia.lat${canonical}` },
  ],
};
---

<Layout title={service.searchTitle} description={service.metaDescription} canonical={canonical} jsonLd={[serviceSchema, breadcrumbSchema]}>
  <Navbar />
  <main id="contenido" class={`service-page service-${service.slug}`}>
    <section class="service-hero">
      <div class="page-shell">
        <div class="service-topline">
          <a href="/#servicios">ZulIA / Servicios</a>
          <span>{narrative.label}</span>
        </div>

        <div class="service-hero-grid" data-reveal>
          <div>
            <p class="service-label">{narrative.descriptor}</p>
            <h1>{service.name}</h1>
          </div>
          <div class="service-intro">
            <p>{service.summary}</p>
            <a class="button-primary" href="#contacto">{narrative.cta}</a>
          </div>
        </div>

        <nav class="service-index" aria-label="Secciones de esta página">
          <a href="#momento"><span>01</span> Cuándo conviene</a>
          <a href="#alcance"><span>02</span> Alcance</a>
          <a href="#evidencia"><span>03</span> Experiencia</a>
          <a href="#proceso"><span>04</span> Proceso</a>
        </nav>

        <ServiceVisual slug={service.slug} />

        <div class="opening-question" data-reveal>
          <span>La pregunta de fondo</span>
          <p>{narrative.question}</p>
        </div>
      </div>
    </section>

    <section class="change section-pad" aria-labelledby="change-title">
      <div class="page-shell change-grid" data-reveal>
        <div class="change-heading">
          <p class="chapter-label">El cambio que buscamos</p>
          <h2 id="change-title">De fricción visible a una ventaja que se puede operar.</h2>
        </div>
        <div class="change-copy">
          <div><span>Hoy</span><p>{narrative.before}</p></div>
          <div><span>Objetivo</span><p>{narrative.after}</p></div>
        </div>
      </div>
    </section>

    {service.slug === 'landing-pages-seo' && <SearchVisibility />}

    <section class="service-story section-pad">
      <div class="page-shell story-layout">
        <div class="story-content">
          <article id="momento" class="story-chapter" data-reveal>
            <div class="chapter-heading"><p class="chapter-label">01 / Cuándo conviene</p><h2>{narrative.momentTitle}</h2></div>
            <div class="chapter-copy"><p>{service.idealFor}</p><blockquote>{service.outcome}</blockquote></div>
          </article>

          <article id="alcance" class="story-chapter capabilities" data-reveal>
            <div class="chapter-heading"><p class="chapter-label">02 / Qué podemos construir</p><h2>{narrative.scopeTitle}</h2></div>
            <ul>
              {service.capabilities.map((capability) => <li><i aria-hidden="true"></i><span>{capability}</span></li>)}
            </ul>
          </article>

          <article id="evidencia" class="story-chapter evidence" data-reveal>
            <div class="chapter-heading"><p class="chapter-label">03 / Experiencia relacionada</p><h2>{narrative.evidenceTitle}</h2></div>
            <div class="evidence-list">
              {narrative.evidence.map((item) => <div><strong>{item.name}</strong><p>{item.context}</p></div>)}
            </div>
          </article>

          <article id="proceso" class="story-chapter process" data-reveal>
            <div class="chapter-heading"><p class="chapter-label">04 / Cómo avanzamos</p><h2>{narrative.processTitle}</h2></div>
            <ol>
              {service.process.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}
            </ol>
          </article>
        </div>
      </div>
    </section>

    {service.slug === 'automatizacion-procesos' && (
      <section class="automation-detail section-pad"><div class="page-shell"><AutomationFlow showLink={false} /></div></section>
    )}

    <section class="related section-pad" aria-labelledby="related-title">
      <div class="page-shell" data-reveal>
        <p class="chapter-label">También podemos ayudarte con</p>
        <h2 id="related-title">Una necesidad rara vez vive en una sola categoría.</h2>
        <nav aria-label="Otros servicios">
          {related.map((item, index) => <a href={`/servicios/${item.slug}/`}><small>{String(index + 1).padStart(2, '0')}</small><span>{item.shortName}</span></a>)}
        </nav>
      </div>
    </section>

    <ContactSection heading={narrative.contactTitle} selectedInterest={narrative.interest} />
  </main>

  <footer class="mini-footer">
    <div class="page-shell"><a href="/">ZulIA</a><span>Haziel Zul · Monterrey · {new Date().getFullYear()}</span></div>
  </footer>
</Layout>

<style>
  .service-hero { position: relative; isolation: isolate; overflow: hidden; padding-block: 2rem clamp(5rem, 10vw, 9rem); background: radial-gradient(circle at 88% 8%, color-mix(in srgb, var(--blue) 14%, transparent), transparent 31%), radial-gradient(circle at 4% 64%, color-mix(in srgb, var(--green) 8%, transparent), transparent 25%), var(--paper); }
  .service-hero::before, .service-hero::after { position: absolute; z-index: -1; border-radius: 43% 57% 62% 38% / 58% 38% 62% 42%; filter: blur(55px); opacity: .55; content: ''; pointer-events: none; animation: hero-liquid 14s ease-in-out infinite alternate; }
  .service-hero::before { top: 6rem; right: -9rem; width: 27rem; height: 22rem; background: color-mix(in srgb, var(--blue) 18%, transparent); }
  .service-hero::after { bottom: 11rem; left: -8rem; width: 21rem; height: 17rem; background: color-mix(in srgb, var(--green) 9%, transparent); animation-delay: -6s; }
  .service-hero .page-shell { position: relative; z-index: 1; }
  .service-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; }
  .service-topline a, .service-topline span, .service-label, .chapter-label { color: var(--text-muted); font-size: .65rem; font-weight: 730; letter-spacing: .065em; text-decoration: none; text-transform: uppercase; }
  .service-topline a:hover { color: var(--blue); }
  .service-hero-grid { display: grid; grid-template-columns: 1.25fr .55fr; align-items: end; gap: clamp(3rem, 8vw, 8rem); margin-top: clamp(4rem, 8vw, 7rem); }
  .service-label { margin: 0 0 1.2rem; color: var(--blue); }
  h1 { max-width: 10.5ch; margin: 0; overflow-wrap: anywhere; font-size: clamp(3.75rem, 7.4vw, 7.6rem); font-weight: 620; letter-spacing: -.07em; line-height: .9; text-wrap: balance; }
  .service-intro p { margin: 0 0 2rem; color: var(--text-muted); font-size: 1rem; line-height: 1.72; }
  .service-index { display: flex; width: fit-content; max-width: 100%; flex-wrap: wrap; gap: .55rem 1.45rem; margin-top: clamp(3rem, 6vw, 5rem); padding: .85rem 1.05rem; border: 0; border-radius: 2rem; background: var(--glass); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%); }
  .service-index a { color: var(--text-muted); font-size: .58rem; font-weight: 650; text-decoration: none; text-transform: uppercase; }
  .service-index a:hover { color: var(--ink); }
  .service-index span { margin-right: .45rem; color: var(--blue); }
  .opening-question { display: grid; grid-template-columns: 10rem 1fr; gap: clamp(2rem, 7vw, 7rem); margin-top: clamp(5rem, 10vw, 9rem); padding: clamp(2rem, 5vw, 4rem); border-radius: 3rem 3rem 6rem 3rem; background: color-mix(in srgb, var(--blue-soft) 50%, var(--white)); }
  .opening-question > span { color: var(--blue); font-size: .65rem; font-weight: 740; letter-spacing: .06em; text-transform: uppercase; }
  .opening-question p { max-width: 29ch; margin: 0; font-size: clamp(1.7rem, 3.4vw, 3.5rem); font-weight: 640; letter-spacing: -.055em; line-height: 1.06; }

  .change { overflow: hidden; background: radial-gradient(circle at 12% 16%, color-mix(in srgb, var(--night-accent) 16%, transparent) 0, transparent 34%), radial-gradient(circle at 88% 78%, color-mix(in srgb, var(--green) 8%, transparent) 0, transparent 29%), var(--night); color: var(--night-text); }
  .change-grid { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: clamp(3rem, 9vw, 9rem); }
  .change-heading h2 { max-width: 12ch; margin: 0; color: var(--night-text); font-size: clamp(2.3rem, 4.8vw, 4.7rem); font-weight: 650; letter-spacing: -.065em; line-height: .96; }
  .change .chapter-label { color: var(--night-accent); }
  .change-copy { display: grid; gap: clamp(1.6rem, 3vw, 2.6rem); }
  .change-copy > div { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding-block: .35rem; border: 0; }
  .change-copy span { padding-top: .25rem; color: var(--night-subtle); font-size: .52rem; font-weight: 730; letter-spacing: .06em; text-transform: uppercase; }
  .change-copy p { margin: 0; color: var(--night-muted); font-size: clamp(1.15rem, 2.2vw, 1.75rem); font-weight: 590; letter-spacing: -.035em; line-height: 1.3; }
  .change-copy > div:last-child p { color: var(--night-accent); }

  .service-story { background: var(--white); }
  .story-layout { display: block; }
  .story-content { min-width: 0; }
  .story-chapter { padding-block: clamp(1rem, 3vw, 2rem) clamp(5rem, 10vw, 9rem); scroll-margin-top: 7rem; }
  .story-chapter + .story-chapter { padding-top: clamp(4rem, 8vw, 7rem); }
  .story-chapter:not(.capabilities) { display: grid; grid-template-columns: minmax(18rem, .9fr) minmax(18rem, .7fr); gap: clamp(3rem, 9vw, 9rem); align-items: start; }
  .chapter-heading { min-width: 0; }
  .chapter-copy { min-width: 0; padding-top: 2.35rem; }
  .chapter-label { margin: 0 0 1.4rem; color: var(--blue); }
  .chapter-heading h2, .related h2 { max-width: 17ch; margin: 0; font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 670; letter-spacing: -.07em; line-height: .94; }
  .chapter-copy > p { margin: 0; color: var(--text-muted); font-size: .9rem; line-height: 1.78; }
  blockquote { margin: 2.5rem 0 0; padding: 1.3rem 1.5rem; border-radius: 1.8rem 1.8rem 3rem 1.8rem; background: var(--paper); color: var(--ink-soft); font-size: clamp(1.1rem, 2vw, 1.55rem); font-weight: 580; letter-spacing: -.025em; line-height: 1.5; }
  .capabilities ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem 2rem; margin: 3rem 0 0; padding: 0; list-style: none; }
  .capabilities li { display: grid; grid-template-columns: 1rem 1fr; align-items: start; gap: .75rem; padding: 1rem 0; }
  .capabilities li i { width: .48rem; height: .48rem; margin-top: .45rem; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 5px color-mix(in srgb, var(--blue) 10%, transparent); }
  .capabilities li span { font-size: clamp(1rem, 2vw, 1.35rem); font-weight: 620; letter-spacing: -.025em; }
  .evidence-list { display: grid; gap: 1.6rem; margin-top: 2.35rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 2.5rem 2.5rem 5rem 2.5rem; background: color-mix(in srgb, var(--paper-deep) 74%, var(--white)); }
  .evidence-list > div { display: grid; gap: .55rem; }
  .evidence-list strong { font-size: .92rem; letter-spacing: -.02em; }
  .evidence-list p { max-width: 30rem; margin: 0; color: var(--text-muted); font-size: .85rem; line-height: 1.6; }
  .process ol { display: grid; gap: 1.2rem; margin: 2.35rem 0 0; padding: 0; list-style: none; }
  .process li { display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; padding: 1.1rem 0; }
  .process li span { color: var(--blue); font-size: .55rem; font-weight: 750; }
  .process li p { max-width: 39rem; margin: 0; font-size: .92rem; line-height: 1.7; }

  .automation-detail { background: var(--paper); }
  .automation-detail :global(.automation-showcase) { margin-block: 0; border-block: 0; }
  .related { background: var(--paper-deep); }
  .related h2 { max-width: 14ch; }
  .related nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: 3rem; }
  .related nav a { display: grid; min-height: 8rem; align-content: space-between; gap: 1rem; padding: 1.2rem; border: 0; border-radius: 1.8rem; background: var(--glass); box-shadow: var(--glass-shadow); color: var(--ink); font-size: .85rem; font-weight: 650; text-decoration: none; -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .related nav a:hover { color: var(--blue); }
  .related nav small { color: var(--blue); font-size: .52rem; }

  .mini-footer { padding-block: 1.5rem; background: var(--night); color: var(--night-text); }
  .mini-footer div { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 0; }
  .mini-footer a, .mini-footer span { color: var(--night-subtle); font-size: .54rem; font-weight: 720; letter-spacing: .04em; text-decoration: none; text-transform: uppercase; }
  .mini-footer a { color: var(--night-text); }

  @keyframes hero-liquid { to { transform: translate3d(2rem, 1.5rem, 0) rotate(8deg) scale(1.08); } }

  @media (max-width: 900px) {
    .service-hero-grid, .change-grid, .story-chapter:not(.capabilities) { grid-template-columns: 1fr; }
    .chapter-copy { padding-top: 0; }
    .evidence-list { margin-top: 0; }
    .related nav { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .service-topline { align-items: flex-start; flex-direction: column; }
    .service-hero { padding-bottom: 4.5rem; }
    .service-hero-grid { margin-top: 3rem; gap: 2rem; }
    .service-index { width: 100%; gap: .75rem 1rem; padding: .85rem 1rem; border-radius: 1.5rem; }
    h1 { max-width: 11ch; font-size: clamp(3rem, 13.5vw, 4.25rem); letter-spacing: -.06em; line-height: .92; }
    .opening-question { grid-template-columns: 1fr; padding: 1.5rem; border-radius: 2rem 2rem 4rem 2rem; }
    .opening-question p { font-size: clamp(1.65rem, 8vw, 2.4rem); }
    .change-copy > div { grid-template-columns: 1fr; }
    .change-copy > i { margin-left: 0; }
    .evidence-list { padding: 1.5rem; border-radius: 2rem 2rem 4rem 2rem; }
    .evidence-list > div { grid-template-columns: 1fr; gap: .6rem; }
    .capabilities ul { grid-template-columns: 1fr; }
    .story-chapter { padding-bottom: 4rem; }
    .story-chapter + .story-chapter { padding-top: 3.5rem; }
    .related nav { margin-top: 2rem; }
    .related nav a { min-height: 7rem; padding: 1.1rem; border-radius: 1.5rem; }
    .mini-footer div { align-items: flex-start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero::before, .service-hero::after { animation: none; }
  }

  @media (prefers-reduced-transparency: reduce) {
    .service-index { background: var(--white); backdrop-filter: none; }
  }
</style>
