# Copia este archivo a .env y llena los valores.
# Todas las variables PUBLIC_* se hornean en el build de Astro (sitio estático),
# así que hay que reconstruir la imagen para que un cambio tenga efecto.

# ID de medición de Google Analytics 4. Admin > Flujos de datos > Web.
# Si se deja vacío, el sitio no carga ningún script de analytics.
PUBLIC_GA_ID=G-XXXXXXXXXX

# Endpoint del servicio de captura de leads de Semilla.
PUBLIC_SEMILLA_LEAD_ENDPOINT=https://zulia.lat/api/lead

# Token de verificación de Google Search Console (solo el valor del meta tag).
PUBLIC_GSC_VERIFICATION=
